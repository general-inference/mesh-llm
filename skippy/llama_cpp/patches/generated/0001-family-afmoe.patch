From 41de630af0ff957828f230b9ca963f7bf75b0feb Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH 01/81] skippy: annotate afmoe graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

diff --git a/src/models/afmoe.cpp b/src/models/afmoe.cpp
index 0eb208f63..23c6a91c3 100644
--- a/src/models/afmoe.cpp
+++ b/src/models/afmoe.cpp
@@ -130,6 +130,8 @@ llama_model_afmoe::graph::graph(const llm_graph_params & params) : llm_graph_con
     const float kq_scale = 1.0f/sqrtf(float(n_embd_head));
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
 
         ggml_tensor * inpSA = inpL;
 
@@ -253,6 +255,7 @@ llama_model_afmoe::graph::graph(const llm_graph_params & params) : llm_graph_con
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
 
     cur = inpL;
