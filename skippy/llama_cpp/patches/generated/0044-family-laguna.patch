From 34b226e8ff3509128c806210ba3c803a04f55f9e Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH 44/81] skippy: annotate laguna graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

diff --git a/src/models/laguna.cpp b/src/models/laguna.cpp
index 0f4029bdb..e903e3554 100644
--- a/src/models/laguna.cpp
+++ b/src/models/laguna.cpp
@@ -191,6 +191,8 @@ llama_model_laguna::graph::graph(const llm_graph_params & params) : llm_graph_co
     const float kq_scale = 1.0f / sqrtf(float(n_embd_head));
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         const int64_t n_head_il   = hparams.n_head(il);
         const int64_t n_head_kv_il = hparams.n_head_kv(il);
 
@@ -320,6 +322,7 @@ llama_model_laguna::graph::graph(const llm_graph_params & params) : llm_graph_co
         cb(cur, "l_out", il);
 
         inpL = cur;
+        end_block(inpL, il);
     }
 
     cur = inpL;
