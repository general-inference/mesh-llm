From 722005243c818d47166abab035a2b4f4c184a810 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH 62/81] skippy: annotate phi3--phi4 graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

diff --git a/src/models/phi3.cpp b/src/models/phi3.cpp
index 815ab0465..94e0061e5 100644
--- a/src/models/phi3.cpp
+++ b/src/models/phi3.cpp
@@ -89,6 +89,8 @@ llama_model_phi3::graph<iswa>::graph(const llm_graph_params & params) : llm_grap
     ggml_tensor * inp_out_ids = build_inp_out_ids();
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         auto * residual = inpL;
 
         // self-attention
@@ -159,6 +161,7 @@ llama_model_phi3::graph<iswa>::graph(const llm_graph_params & params) : llm_grap
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
     cur = build_norm(inpL,
             model.output_norm,
