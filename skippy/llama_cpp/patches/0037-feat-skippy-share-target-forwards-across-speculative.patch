+/** @brief One independently sampled speculative window in a shared forward. */
+struct skippy_verify_request {
+        struct skippy_session * session;
+        const llama_token * token_ids;
+        size_t token_count;
+        const struct skippy_sampling_config * sampling;
+        llama_token * output_tokens;
+        size_t output_capacity;
+        size_t * out_token_count;
+};
+
+/**
+ * @brief Verify equal-length windows on independent lanes of one terminal model.
+ *
+ * Every window retains its own rollback checkpoint and sampler history. Sampling
+ * stops at the first rejected proposal in each lane. The caller must trim or
+ * retire every window before reusing that lane. The combined windows must fit
+ * one native microbatch. Activation-frontier stages are not supported here.
+ */
+LLAMA_API enum skippy_status skippy_verify_batch_sampled(
+        const struct skippy_verify_request * requests,
+        size_t request_count,
+        struct skippy_error ** out_error);
+
