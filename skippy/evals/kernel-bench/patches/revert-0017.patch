-
-// DGX Spark (GB10): the integer-path types run four warps of 32 rows per CTA at two CTAs per SM,
-// so one CTA's tile loads can overlap the other's MMA. The J search stops at 64: wider tiles
-// measured slower, as did I=64 tiles, eight-warp CTAs at occupancy 2 and occupancy 4. Measured against the Blackwell table on a Spark (prefill tok/s):
-// Qwen3.6-27B Q4_K_M +30%, Qwen3.5-9B Q4_K_M +23% at ubatch 2048, Qwen3.6-35B-A3B +36-58%,
-// and its 16-64 token MUL_MAT_ID batches +70-90%. FP4 types keep the Blackwell config.
-static constexpr __host__ __device__ ggml_cuda_mmq_config ggml_cuda_mmq_get_config_gb10(ggml_type type, int J, bool fallback) {
-    ggml_cuda_mmq_config config = ggml_cuda_mmq_get_config_blackwell(type, J, fallback);
-    if (config.type == GGML_TYPE_COUNT || type == GGML_TYPE_MXFP4 || type == GGML_TYPE_NVFP4) {
-        return config;
-    }
-    if (J > 64) {
-        config.type = GGML_TYPE_COUNT;
-    }
-    config.nthreads  = 128;
-    config.occupancy = 2;
-    return config;
-}
