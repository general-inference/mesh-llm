From 5418a05df1865c1b686abbd0c7d43c10db54551a Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH 20/81] skippy: annotate gemma2 graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

diff --git a/src/models/gemma2.cpp b/src/models/gemma2.cpp
index 826396ce1..2bd67f512 100644
--- a/src/models/gemma2.cpp
+++ b/src/models/gemma2.cpp
@@ -76,6 +76,8 @@ llama_model_gemma2::graph::graph(const llm_graph_params & params) : llm_graph_co
     ggml_tensor * inp_out_ids = build_inp_out_ids();
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
 
         // norm
         cur = build_norm(inpL,
@@ -141,6 +143,7 @@ llama_model_gemma2::graph::graph(const llm_graph_params & params) : llm_graph_co
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
     cur = inpL;
 
