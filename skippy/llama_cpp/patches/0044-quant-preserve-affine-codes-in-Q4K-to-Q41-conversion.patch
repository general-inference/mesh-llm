 src/llama-quant.cpp            | 16 +++++--
 tests/CMakeLists.txt           |  1 +
 tests/test-quantize-affine.cpp | 88 ++++++++++++++++++++++++++++++++++
 4 files changed, 143 insertions(+), 4 deletions(-)
 create mode 100644 src/llama-quant-affine.h
