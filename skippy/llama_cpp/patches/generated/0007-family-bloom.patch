Subject: [PATCH 07/81] skippy: annotate bloom graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

diff --git a/src/models/bloom.cpp b/src/models/bloom.cpp
index 076927e0d..48e3f3a10 100644
--- a/src/models/bloom.cpp
+++ b/src/models/bloom.cpp
@@ -83,6 +83,8 @@ llama_model_bloom::graph::graph(const llm_graph_params & params) : llm_graph_con
     ggml_tensor * inp_out_ids = build_inp_out_ids();
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         cur = build_norm(inpL,
                 model.layers[il].attn_norm,
                 model.layers[il].attn_norm_b,
@@ -132,6 +134,7 @@ llama_model_bloom::graph::graph(const llm_graph_params & params) : llm_graph_con
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
 
     cur = build_norm(inpL,
