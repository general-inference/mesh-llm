+int main(int argc, char ** argv) {
+    try {
+        const bool policy_only = argc==2 && std::strcmp(argv[1], "--policy-only")==0;
+        require(argc==1 || policy_only, "usage: test-metal-routed-u32 [--policy-only]");
+        policy_checks(); if (policy_only) return 0;
+        ggml_log_set(logger, nullptr); old_library_check(); compiled.store(0); compiled_r4.store(0);
+        ggml_backend_load_all(); auto backend = ggml_backend_init_by_name("MTL0", nullptr); require(backend, "Metal backend missing");
+        int cases = 0;
+        for (int k : {2048, 512}) for (int experts : {128, 256}) for (int inputs : {1, 8}) for (bool view : {false, true}) {
+            run_case(backend,k,k==2048?512:2048,experts,16,inputs,view,false); ++cases;
+        }
+        for (int tokens : {3,8,15,17}) for (int inputs : {1,8}) { run_case(backend,512,2048,128,tokens,inputs,true,false); ++cases; }
+        for (int k : {2048,512}) { run_case(backend,k,k==2048?512:2048,128,16,8,true,true); ++cases; }
+        for (int tokens : {1,2}) for (int k : {2048,512}) for (int inputs : {1,8}) {
+            run_case(backend,k,k==2048?512:2048,128,tokens,inputs,true,false); ++cases;
+        }
+        for (int tokens : {3,8,15}) for (int inputs : {1,8}) {
+            run_case(backend,2048,512,128,tokens,inputs,true,false); ++cases;
+        }
+        require(compiled.load() > 0, "new R8 native pipeline never compiled");
+        require(compiled_r4.load() > 0, "new R4 native pipeline never compiled");
+
+
+        std::printf("PASS native_cases=%d paired_outputs=%d fp64_checks=%d u32_pipeline_compiles=%d r4_pipeline_compiles=%d\n",cases,2*cases,4*cases,compiled.load(),compiled_r4.load());
+        ggml_backend_free(backend); return 0;
+    } catch (const std::exception & error) { std::fprintf(stderr,"FAIL: %s\n",error.what()); return 1; }
+}
