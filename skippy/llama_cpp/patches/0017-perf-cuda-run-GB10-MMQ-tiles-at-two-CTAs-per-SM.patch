From 4fb15f9909c5b6a187770f3ba84641af14011c5c Mon Sep 17 00:00:00 2001
From: Daniel Winter <danielwinterw@gmail.com>
Date: Tue, 10 Nov 2026 21:52:02 +1100
Subject: [PATCH] perf(cuda): run GB10 MMQ tiles at two CTAs per SM

On DGX Spark (GB10) the integer-path MMQ types now use 128-thread CTAs
at occupancy 2 with J tiles of at most 64 columns, instead of the
Blackwell table's 256-thread CTAs at occupancy 1 with J up to 128. Two
CTAs per SM let one CTA's tile loads overlap the other's MMA; the main
loop itself has no software pipelining.

Prefill tok/s against the Blackwell table, same Spark, llama-bench -fa 1:

  Qwen3.6-27B Q4_K_M        ub 512   933 -> 1249  (+34%)
                             ub 2048  958 -> 1244  (+30%)
  Qwen3.5-9B Q4_K_M         ub 2048 3102 -> 3844  (+24%)
  Qwen3.6-35B-A3B UD-Q4_K_M ub 512  2818 -> 4442  (+58%)
                             ub 2048 3634 -> 4974  (+37%)

The MoE model's 16-64 token MUL_MAT_ID batches (speculative verify)
run 72-90% faster. Dense 16-32 token batches are 1-2% slower; decode
and batches of at most 8 tokens use MMVQ and are unchanged.

Only GB10 changes: host and device both select the new table only when
the running arch is sm_121, and FP4 types keep the Blackwell config.
Wider J caps (128), narrower ones (32, 48), I=64 tiles, eight-warp CTAs
at occupancy 2 and occupancy 4 all measured slower.
---
 ggml/src/ggml-cuda/mmq-config-blackwell.cuh | 18 ++++++++++++++++++
 ggml/src/ggml-cuda/mmq.cuh                  |  7 +++++++
 2 files changed, 25 insertions(+)

diff --git a/ggml/src/ggml-cuda/mmq-config-blackwell.cuh b/ggml/src/ggml-cuda/mmq-config-blackwell.cuh
index 9fbe32b69..c6cfeab71 100644
--- a/ggml/src/ggml-cuda/mmq-config-blackwell.cuh
+++ b/ggml/src/ggml-cuda/mmq-config-blackwell.cuh
@@ -35,3 +35,21 @@ static constexpr __host__ __device__ ggml_cuda_mmq_config ggml_cuda_mmq_get_conf
 
     return ggml_cuda_mmq_get_config_ampere(type, J, fallback);
 }
+
+// DGX Spark (GB10): the integer-path types run four warps of 32 rows per CTA at two CTAs per SM,
+// so one CTA's tile loads can overlap the other's MMA. The J search stops at 64: wider tiles
+// measured slower, as did I=64 tiles, eight-warp CTAs at occupancy 2 and occupancy 4. Measured against the Blackwell table on a Spark (prefill tok/s):
+// Qwen3.6-27B Q4_K_M +30%, Qwen3.5-9B Q4_K_M +23% at ubatch 2048, Qwen3.6-35B-A3B +36-58%,
+// and its 16-64 token MUL_MAT_ID batches +70-90%. FP4 types keep the Blackwell config.
+static constexpr __host__ __device__ ggml_cuda_mmq_config ggml_cuda_mmq_get_config_gb10(ggml_type type, int J, bool fallback) {
+    ggml_cuda_mmq_config config = ggml_cuda_mmq_get_config_blackwell(type, J, fallback);
+    if (config.type == GGML_TYPE_COUNT || type == GGML_TYPE_MXFP4 || type == GGML_TYPE_NVFP4) {
+        return config;
+    }
+    if (J > 64) {
+        config.type = GGML_TYPE_COUNT;
+    }
+    config.nthreads  = 128;
+    config.occupancy = 2;
+    return config;
+}
diff --git a/ggml/src/ggml-cuda/mmq.cuh b/ggml/src/ggml-cuda/mmq.cuh
index 4d67555ef..a83dd4d34 100644
--- a/ggml/src/ggml-cuda/mmq.cuh
+++ b/ggml/src/ggml-cuda/mmq.cuh
@@ -257,6 +257,9 @@ static __host__ ggml_cuda_mmq_config ggml_cuda_mmq_get_config(const ggml_type ty
         if (prec_src1 != GGML_PREC_Q4 && (type == GGML_TYPE_NVFP4 || type == GGML_TYPE_MXFP4)) {
             return ggml_cuda_mmq_get_config_ampere(type, J, fallback);
         }
+        if (ggml_cuda_highest_compiled_arch(cc) == GGML_CUDA_CC_DGX_SPARK) {
+            return ggml_cuda_mmq_get_config_gb10(type, J, fallback);
+        }
         return ggml_cuda_mmq_get_config_blackwell(type, J, fallback);
     }
     if (ggml_cuda_highest_compiled_arch(cc) >= GGML_CUDA_CC_VOLTA) {
@@ -291,7 +294,11 @@ static constexpr __device__ ggml_cuda_mmq_config ggml_cuda_mmq_get_config(ggml_t
     if (prec_src1 != GGML_PREC_Q4 && (type == GGML_TYPE_NVFP4 || type == GGML_TYPE_MXFP4)) {
         return ggml_cuda_mmq_get_config_ampere(type, J, fallback);
     }
+#if __CUDA_ARCH__ == GGML_CUDA_CC_DGX_SPARK
+    return ggml_cuda_mmq_get_config_gb10(type, J, fallback);
+#else
     return ggml_cuda_mmq_get_config_blackwell(type, J, fallback);
+#endif // __CUDA_ARCH__ == GGML_CUDA_CC_DGX_SPARK
 #elif !defined(GGML_USE_MUSA) && __CUDA_ARCH__ >= GGML_CUDA_CC_VOLTA
     return ggml_cuda_mmq_get_config_ampere(type, J, fallback);
 #elif !defined(GGML_USE_MUSA) && __CUDA_ARCH__ >= GGML_CUDA_CC_DP4A
-- 
