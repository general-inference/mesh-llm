From a561b09887358cfbc3e8e60c48c773b4b0dd4497 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH 57/81] skippy: annotate mpt graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

diff --git a/src/models/mpt.cpp b/src/models/mpt.cpp
index 774907b4d..0289715fb 100644
--- a/src/models/mpt.cpp
+++ b/src/models/mpt.cpp
@@ -90,6 +90,8 @@ llama_model_mpt::graph::graph(const llm_graph_params & params) : llm_graph_conte
     ggml_tensor * inp_out_ids = build_inp_out_ids();
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         ggml_tensor * attn_norm;
 
         attn_norm = build_norm(inpL, model.layers[il].attn_norm, model.layers[il].attn_norm_b, LLM_NORM, il);
@@ -152,6 +154,7 @@ llama_model_mpt::graph::graph(const llm_graph_params & params) : llm_graph_conte
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
 
     cur = inpL;
