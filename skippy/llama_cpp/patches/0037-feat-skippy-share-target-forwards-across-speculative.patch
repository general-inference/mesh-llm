+void shared_verify_preserves_independent_grammars(const char * path) {
+    auto config = skippy_runtime_config_default();
+    config.selected_backend_device = "CPU";
+    config.ctx_size = 512;
+    config.lane_count = 2;
+    skippy_model * model = nullptr;
+    skippy_error * error = nullptr;
+    ok(skippy_model_open(path, &config, &model, &error), error);
+    auto * first = create(model);
+    auto * second = create(model);
+    const auto sampling = sampling_config();
+    const std::vector<llama_token> prefix[2] = {{1, 2, 3, 4}, {1, 4, 3, 2, 5}};
+    configure(first, sampling, false, prefix[0].size() + 1);
+    configure(second, sampling, false, prefix[1].size() + 1);
+    prefill(first, prefix[0]);
+    prefill(second, prefix[1]);
+    auto * second_sampler = second->sampler;
+    const llama_token inputs[2][3] = {{2, 42, 43}, {3, 42, 0}};
+    llama_token outputs[2][3] = {};
+    size_t counts[2] = {};
+    const skippy_verify_request requests[2] = {
+        {first, inputs[0], 3, &sampling, outputs[0], 3, &counts[0]},
+        {second, inputs[1], 3, &sampling, outputs[1], 3, &counts[1]},
+    };
+    error = nullptr;
+    ok(skippy_verify_batch_sampled(requests, 2, &error), error);
+    CHECK(counts[0] == 3 && counts[1] == 2);
+    CHECK(outputs[0][0] == 42 && outputs[0][1] == 43 && outputs[0][2] == 44);
+    CHECK(outputs[1][0] == 42 && outputs[1][1] == 43);
+    error = nullptr;
+    ok(skippy_retire_verify_checkpoint(first, prefix[0].size(), 3, &error), error);
+    error = nullptr;
+    ok(skippy_trim_session(second, prefix[1].size() + 2, &error), error);
+    CHECK(second->sampler == second_sampler && second->sampling_has_grammar);
+    CHECK(second->sampling_accepted_token_count == prefix[1].size() + 2);
+    CHECK(decode(second, sampling, 43) == 44);
+    release(first);
+    release(second);
+    error = nullptr;
+    ok(skippy_model_free(model, &error), error);
+}
+
 } // namespace
 
