+static int policy_checks() {
+    using namespace ggml_metal_routed_offsets;
+    storage s; require(s.ctx, "context");
+    auto * w = ggml_new_tensor_3d(s.ctx, GGML_TYPE_Q4_1, 512, 2048, 256);
+    auto * x = ggml_new_tensor_3d(s.ctx, GGML_TYPE_F32, 512, 8, 16);
+    auto * ids = ggml_new_tensor_2d(s.ctx, GGML_TYPE_I32, 8, 16);
+    auto * out = ggml_mul_mat_id(s.ctx, w, x, ids);
+    const auto admitted = [&] { return eligible(out, GGML_METAL_DEVICE_M1_ULTRA, true, 8, 2); };
+    int checks = 0;
+    for (auto device : {GGML_METAL_DEVICE_M1_ULTRA, GGML_METAL_DEVICE_M4,
+                       GGML_METAL_DEVICE_M5_MAX, GGML_METAL_DEVICE_M3_ULTRA}) {
+        require(requested(nullptr,device)==(device==GGML_METAL_DEVICE_M1_ULTRA), "unqualified default"); ++checks;
+        require(!requested("0",device), "diagnostic opt-out"); ++checks;
+        require(requested("1",device), "explicit diagnostic opt-in"); ++checks;
+        require(requested_r8(nullptr,device)==(device==GGML_METAL_DEVICE_M1_ULTRA || device==GGML_METAL_DEVICE_M5_MAX), "R8 default policy"); ++checks;
+        require(!requested_r8("0",device), "R8 diagnostic opt-out"); ++checks;
+        require(requested_r8("1",device), "R8 diagnostic opt-in"); ++checks;
+
+    }
+
+    require(admitted(), "good geometry rejected"); ++checks;
+    require(!eligible(out, GGML_METAL_DEVICE_M1_ULTRA, true, 4, 2), "NR4 must remain NR4"); ++checks;
+    require(!eligible(out, GGML_METAL_DEVICE_M1_ULTRA, false, 8, 2), "private mode admitted"); ++checks;
+    require(!eligible(out, GGML_METAL_DEVICE_M1_ULTRA, true, 8, 1), "wrong SIMD groups"); ++checks;
+    require(!eligible(out, GGML_METAL_DEVICE_M3_ULTRA, true, 8, 2), "unqualified device"); ++checks;
+    for (auto * tensor : {w, x, ids, out}) {
+        auto saved = *tensor;
+        tensor->nb[1] = UINT64_MAX;
+        require(!admitted(), "overflow stride admitted"); ++checks; *tensor = saved;
+        tensor->ne[3] = 2;
+        require(!admitted(), "extra dimension admitted"); ++checks; *tensor = saved;
+    }
+    const size_t stride = ids->nb[1];
+    ids->nb[1] = 12*sizeof(int32_t);
+    require(admitted(), "padded ID rows rejected"); ++checks;
+    ids->nb[1] = stride;
+    for (int64_t tokens : {1, 3, 8, 15, 17, 32}) {
+        ids->ne[1] = tokens; require(!admitted(), "token fallback admitted"); ++checks;
+    }
+    ids->ne[1] = 16;
+    ggml_tensor boundary{}; boundary.type = GGML_TYPE_I8;
+    for (int i = 0; i < GGML_MAX_DIMS; ++i) { boundary.ne[i] = 1; boundary.nb[i] = 1; }
+    boundary.ne[0] = UINT32_MAX;
+    require(fits_u32(&boundary), "exact byte limit"); ++checks;
+    ++boundary.ne[0]; require(!fits_u32(&boundary), "limit overflow"); ++checks;
+    boundary.ne[0] = 1; boundary.ne[1] = 3; boundary.nb[1] = UINT64_MAX;
+    require(!fits_u32(&boundary), "stride overflow"); ++checks;
+    boundary.type = GGML_TYPE_Q4_1; boundary.ne[0] = 33;
+    require(!fits_u32(&boundary), "partial quant block"); ++checks;
+    for (int tokens : {1, 2, 3, 8, 15, 16, 17}) {
+        auto * xi = ggml_new_tensor_3d(s.ctx, GGML_TYPE_F32, 512, 8, tokens);
+        auto * idi = ggml_new_tensor_2d(s.ctx, GGML_TYPE_I32, 8, tokens);
+        auto * yi = ggml_mul_mat_id(s.ctx, w, xi, idi);
+        require(eligible_r4(yi, GGML_METAL_DEVICE_M1_ULTRA, true, 4, 2)==(tokens<=16), "R4 token admission"); ++checks;
+        require(!eligible_r4(yi, GGML_METAL_DEVICE_M1_ULTRA, true, 8, 2), "R4 changed row geometry"); ++checks;
+        require(!eligible_r4(yi, GGML_METAL_DEVICE_M1_ULTRA, false, 4, 2), "R4 private allocation"); ++checks;
+        idi->nb[1]=UINT64_MAX;
+        require(eligible_r4(yi, GGML_METAL_DEVICE_M1_ULTRA, true, 4, 2)==(tokens==1), "R4 ID span bound"); ++checks;
+    }
+    for (int tokens : {1, 2, 3, 8, 15, 16, 17}) {
+        auto * xi = ggml_new_tensor_3d(s.ctx, GGML_TYPE_F32, 512, 8, tokens);
+        auto * idi = ggml_new_tensor_2d(s.ctx, GGML_TYPE_I32, 8, tokens);
+        auto * yi = ggml_mul_mat_id(s.ctx, w, xi, idi);
+        require(eligible(yi, GGML_METAL_DEVICE_M5_MAX, true, 8, 2)==(tokens>=3 && tokens<=16), "R8 window admission"); ++checks;
+        require(!eligible(yi, GGML_METAL_DEVICE_M5_MAX, true, 4, 2), "R8 row geometry changed"); ++checks;
+        require(!eligible(yi, GGML_METAL_DEVICE_M5_MAX, false, 8, 2), "R8 private allocation"); ++checks;
+    }
+    std::printf("PASS policy_checks=%d\n", checks);
+
+
+    return checks;
+}
