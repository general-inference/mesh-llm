+static void run_case(ggml_backend_t backend, int k, int m, int experts, int tokens,
+                     int input_rows, bool id_view, bool weight_view) {
+    storage s; auto * ctx = s.ctx;
+    const int weight_rows = m + (weight_view ? 16 : 0);
+    auto * weight_root = ggml_new_tensor_3d(ctx, GGML_TYPE_Q4_1, k, weight_rows, experts);
+    auto * weights = weight_view ? ggml_view_3d(ctx, weight_root, k, m, experts, weight_root->nb[1], weight_root->nb[2], 0) : weight_root;
+    auto * input = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, k, input_rows, tokens);
+    const int id_rows = id_view ? 12 : 8;
+    auto * id_root = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, id_rows, tokens);
+    auto * ids = id_view ? ggml_view_2d(ctx, id_root, 8, tokens, id_root->nb[1], sizeof(int32_t)) : id_root;
+    auto * out = ggml_mul_mat_id(ctx, weights, input, ids);
+    auto * graph = ggml_new_graph_custom(ctx, 64, false); ggml_build_forward_expand(graph, out);
+    s.buffer = ggml_backend_alloc_ctx_tensors(ctx, backend); require(s.buffer, "native buffer allocation");
+    std::vector<q4> w(ggml_nbytes(weight_root)/sizeof(q4));
+    uint32_t random = 0x4158fc17;
+    for (size_t i = 0; i < w.size(); ++i) {
+        w[i].d = ggml_fp32_to_fp16(.0013f + .000071f*(i%31));
+        w[i].m = ggml_fp32_to_fp16(-.013f + .00091f*(i%29));
+        for (auto & q : w[i].qs) { random ^= random<<13; random ^= random>>17; random ^= random<<5; q = uint8_t(random); }
+    }
+    std::vector<float> x(ggml_nelements(input));
+    for (size_t i = 0; i < x.size(); ++i) x[i] = std::sin(double(i)*.017)*.25 + std::cos(double(i)*.041)*.13;
+    ggml_backend_tensor_set(weight_root, w.data(), 0, ggml_nbytes(weight_root));
+    ggml_backend_tensor_set(input, x.data(), 0, ggml_nbytes(input));
+    for (int frame : {0, 17}) {
+        std::vector<int32_t> route(id_rows*tokens, 0);
+        for (int t = 0; t < tokens; ++t) for (int r = 0; r < 8; ++r) route[t*id_rows+r+int(id_view)] = (t*17+r*13+frame*7)%experts;
+        route[int(id_view)+7] = -1;
+        route[(tokens-1)*id_rows+int(id_view)+7] = experts-1;
+        ggml_backend_tensor_set(id_root, route.data(), 0, ggml_nbytes(id_root));
+        std::vector<float> arms[2];
+        for (int arm = 0; arm < 2; ++arm) {
+            setenv("GGML_METAL_ROUTED_U32", arm ? "1" : "0", 1);
+            setenv("GGML_METAL_ROUTED_U32_R4", arm ? "1" : "0", 1);
+
+            std::vector<float> poison(ggml_nelements(out), std::nanf(""));
+            ggml_backend_tensor_set(out, poison.data(), 0, ggml_nbytes(out));
+            require(ggml_backend_graph_compute(backend, graph) == GGML_STATUS_SUCCESS, "native graph failed");
+            ggml_backend_synchronize(backend);
+            arms[arm].resize(ggml_nelements(out)); ggml_backend_tensor_get(out, arms[arm].data(), 0, ggml_nbytes(out));
+            for (float value : arms[arm]) require(std::isfinite(value), "incomplete finite output coverage");
+            double error = 0, scale = 0;
+            for (int t = 0; t < tokens; ++t) for (int r = 0; r < 8; ++r) {
+                const int expert = route[t*id_rows+r+int(id_view)];
+                if (expert == -1) { for (int row = 0; row < m; ++row) require(arms[arm][(t*8+r)*m+row] == 0, "masked nonzero"); continue; }
+                for (int row : {0, 7, 8, 15, 16, 127, m/2, m-1}) {
+                    double expected = 0;
+                    for (int col = 0; col < k; ++col) {
+                        const auto & q = w[(size_t(expert)*weight_rows+row)*(k/32)+col/32];
+                        const int code = col%32 < 16 ? q.qs[col%16]&15 : q.qs[col%16]>>4;
+                        const double value = double(ggml_fp16_to_fp32(q.d))*code + ggml_fp16_to_fp32(q.m);
+                        expected += value*x[(size_t(t)*input_rows+r%input_rows)*k+col];
+                    }
+                    const double delta = arms[arm][(t*8+r)*m+row]-expected;
+                    error += delta*delta; scale += expected*expected;
+                }
+            }
+            require(error/std::fmax(scale, 1e-30) < 1e-9, "native FP64 oracle mismatch");
+        }
+        size_t different = 0; double delta2 = 0, ref2 = 0;
+        for (size_t i = 0; i < arms[0].size(); ++i) { different += std::memcmp(&arms[0][i], &arms[1][i], sizeof(float)) != 0; const double d = double(arms[0][i])-arms[1][i]; delta2 += d*d; ref2 += double(arms[0][i])*arms[0][i]; }
+        if (different) std::fprintf(stderr,"PAIR_DIFFERENCE k=%d m=%d frame=%d entries=%zu nmse=%.15g compiles=%d\n",k,m,frame,different,delta2/std::fmax(ref2,1e-30),compiled.load());
+        require(std::memcmp(arms[0].data(), arms[1].data(), ggml_nbytes(out)) == 0, "native paired output differs");
+        std::printf("PASS native_pair k=%d m=%d experts=%d tokens=%d input_rows=%d id_view=%d weight_view=%d frame=%d bytes=%zu\n",
+            k,m,experts,tokens,input_rows,id_view,weight_view,frame,ggml_nbytes(out));
+    }
+}
