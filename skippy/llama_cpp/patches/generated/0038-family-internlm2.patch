From 97c567a6dc8caa83d00a3a9e5b2ad36fcaf3e08d Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH 38/81] skippy: annotate internlm2 graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

diff --git a/src/models/internlm2.cpp b/src/models/internlm2.cpp
index 39ce67af6..886c12971 100644
--- a/src/models/internlm2.cpp
+++ b/src/models/internlm2.cpp
@@ -57,6 +57,8 @@ llama_model_internlm2::graph::graph(const llm_graph_params & params) : llm_graph
     ggml_tensor * inp_out_ids = build_inp_out_ids();
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         ggml_tensor * inpSA = inpL;
 
         // norm
@@ -110,6 +112,7 @@ llama_model_internlm2::graph::graph(const llm_graph_params & params) : llm_graph
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
     cur = inpL;
 
