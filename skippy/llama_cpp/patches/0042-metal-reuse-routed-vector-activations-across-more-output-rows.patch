+static void old_library_check() {
+    auto device = ggml_metal_device_init(0, 1); require(device, "device");
+    auto old = ggml_metal_library_init_from_source(device,
+        "#include <metal_stdlib>\nusing namespace metal;\nkernel void kernel_mul_mv_id_q4_1_f32_r8() {}\n", false);
+    require(old, "old combined library");
+    require(ggml_metal_library_has_function(old, "kernel_mul_mv_id_q4_1_f32_r8"), "old function missing");
+    require(!ggml_metal_library_has_function(old, "kernel_mul_mv_id_q4_1_f32_r8_u32"), "old function discovery false positive");
+    require(!ggml_metal_library_has_function(old, "kernel_mul_mv_id_q4_1_f32_r8_u32"), "negative discovery cache false positive");
+    require(ggml_metal_library_has_function(old, "kernel_mul_mv_id_q4_1_f32_r8"), "positive discovery cache lost function");
+
+    storage s;
+    auto * w = ggml_new_tensor_3d(s.ctx, GGML_TYPE_Q4_1, 512, 2048, 256);
+    auto * x = ggml_new_tensor_3d(s.ctx, GGML_TYPE_F32, 512, 8, 16);
+    auto * ids = ggml_new_tensor_2d(s.ctx, GGML_TYPE_I32, 8, 16);
+    auto * out = ggml_mul_mat_id(s.ctx, w, x, ids);
+    setenv("GGML_METAL_ROUTED_U32", "1", 1);
+    auto selected = ggml_metal_library_get_pipeline_mul_mv_id(old, out);
+    auto fallback = ggml_metal_library_get_pipeline(old, "kernel_mul_mv_id_q4_1_f32_r8_nsg=2_split=0");
+    require(selected.pipeline && selected.pipeline == fallback.pipeline && selected.nr0 == 8, "old-library fallback failed");
+    ggml_metal_library_free(old); ggml_metal_device_free(device);
+    device = ggml_metal_device_init(0, 1); require(device, "R4 fallback device");
+    old = ggml_metal_library_init_from_source(device,
+        "#include <metal_stdlib>\nusing namespace metal;\nkernel void kernel_mul_mv_id_q4_1_f32() {}\n", false);
+    require(old, "R4 old combined library");
+    require(!ggml_metal_library_has_function(old,"kernel_mul_mv_id_q4_1_f32_r4_u32"), "R4 missing function");
+    require(!ggml_metal_library_has_function(old,"kernel_mul_mv_id_q4_1_f32_r4_u32"), "R4 negative discovery cache");
+    auto * x4 = ggml_new_tensor_3d(s.ctx, GGML_TYPE_F32, 512, 8, 1);
+    auto * ids4 = ggml_new_tensor_2d(s.ctx, GGML_TYPE_I32, 8, 1);
+    auto * out4 = ggml_mul_mat_id(s.ctx,w,x4,ids4);
+    setenv("GGML_METAL_ROUTED_U32_R4", "1", 1);
+    selected = ggml_metal_library_get_pipeline_mul_mv_id(old,out4);
+    fallback = ggml_metal_library_get_pipeline(old,"kernel_mul_mv_id_q4_1_f32_nsg=2_split=0");
+    require(selected.pipeline && selected.pipeline==fallback.pipeline && selected.nr0==4,"R4 old library fallback failed");
+    ggml_metal_library_free(old); ggml_metal_device_free(device);
+    std::puts("PASS old_combined_library_fallback=1 r4_fallback=1");
+
+}
