From b12499a6952fb81d1c0d588d6cd3b9659ecb70ff Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH 02/81] skippy: annotate apertus graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

diff --git a/src/models/apertus.cpp b/src/models/apertus.cpp
index c0bb23659..dd89464b7 100644
--- a/src/models/apertus.cpp
+++ b/src/models/apertus.cpp
@@ -77,6 +77,8 @@ llama_model_apertus::graph::graph(const llm_graph_params & params) : llm_graph_c
     ggml_tensor * inp_out_ids = build_inp_out_ids();
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         ggml_tensor * inpSA = inpL;
 
         cur = build_norm(inpL, model.layers[il].attn_norm, nullptr, LLM_NORM_RMS, il);
@@ -146,6 +148,7 @@ llama_model_apertus::graph::graph(const llm_graph_params & params) : llm_graph_c
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
 
     cur = inpL;
