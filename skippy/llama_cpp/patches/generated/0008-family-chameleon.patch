From 251892eaa98628dbe3aef0d8d43bfee43de88d9e Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH 08/81] skippy: annotate chameleon graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

diff --git a/src/models/chameleon.cpp b/src/models/chameleon.cpp
index 23402da4a..8f44cdd2f 100644
--- a/src/models/chameleon.cpp
+++ b/src/models/chameleon.cpp
@@ -69,6 +69,8 @@ llama_model_chameleon::graph::graph(const llm_graph_params & params) : llm_graph
     ggml_tensor * inp_out_ids = build_inp_out_ids();
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         ggml_tensor * inpSA = inpL;
 
         // norm
@@ -160,6 +162,7 @@ llama_model_chameleon::graph::graph(const llm_graph_params & params) : llm_graph
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
 
     cur = inpL;
