diff --git a/ggml/src/ggml-metal/ggml-metal-routed-offsets.h b/ggml/src/ggml-metal/ggml-metal-routed-offsets.h
new file mode 100644
index 000000000..30fc69a5d
--- /dev/null
+++ b/ggml/src/ggml-metal/ggml-metal-routed-offsets.h
@@ -0,0 +1,70 @@
+#pragma once
+
+#include "ggml-metal-device.h"
+#include <cstdint>
+#include <cstring>
+
+namespace ggml_metal_routed_offsets {
+
+// M1 has complete repeated serving qualification. Other admitted chips retain
+// the original path by default; the private flag permits explicit diagnostics.
+inline bool requested(const char * value, ggml_metal_device_id device) {
+    return value ? std::strcmp(value, "1") == 0 : device == GGML_METAL_DEVICE_M1_ULTRA;
+}
+
+// R8 has separate qualification; enabling it does not enable the R4 diagnostic.
+inline bool requested_r8(const char * value, ggml_metal_device_id device) {
+    return value ? std::strcmp(value, "1") == 0 :
+            device == GGML_METAL_DEVICE_M1_ULTRA || device == GGML_METAL_DEVICE_M5_MAX;
+}
+
+// Inclusive bound on every byte touched relative to the tensor's bound base.
+// Handle quantized block strides and padded ID views without size_t overflow.
+inline bool fits_u32(const ggml_tensor * tensor) {
+    if (!tensor) return false;
+    uint64_t bytes = ggml_type_size(tensor->type);
+    const uint64_t limit = UINT32_MAX;
+    for (int dim = 0; dim < GGML_MAX_DIMS; ++dim) {
+        const int64_t blocks = dim == 0 ? ggml_blck_size(tensor->type) : 1;
+        if (tensor->ne[dim] <= 0 || tensor->ne[dim] % blocks != 0) return false;
+        const uint64_t steps = uint64_t(tensor->ne[dim]/blocks - 1);
+        if (bytes > limit || (steps && tensor->nb[dim] > (limit - bytes)/steps)) return false;
+        bytes += steps*tensor->nb[dim];
+    }
+    return bytes <= limit;
+}
+
+inline bool eligible_geometry(const ggml_tensor * op, ggml_metal_device_id device,
+                              bool shared, int rows, int simdgroups, int required_rows,
+                              int64_t min_tokens, int64_t max_tokens) {
+    if (!op || op->op != GGML_OP_MUL_MAT_ID || !shared || rows != required_rows || simdgroups != 2) return false;
+    if (device != GGML_METAL_DEVICE_M1_ULTRA && device != GGML_METAL_DEVICE_M4 &&
+            device != GGML_METAL_DEVICE_M5_MAX) return false;
+    const auto * weights = op->src[0];
+    const auto * input = op->src[1];
+    const auto * ids = op->src[2];
+    if (!weights || !input || !ids || weights->type != GGML_TYPE_Q4_1 ||
+            input->type != GGML_TYPE_F32 || ids->type != GGML_TYPE_I32 || op->type != GGML_TYPE_F32) return false;
+    const int64_t inner = weights->ne[0], output = weights->ne[1];
+    if (!((inner == 512 && output == 2048) || (inner == 2048 && output == 512))) return false;
+    if (weights->ne[2] != 128 && weights->ne[2] != 256) return false;
+    if (weights->ne[3] != 1 || input->ne[3] != 1 || op->ne[3] != 1 ||
+            ids->ne[2] != 1 || ids->ne[3] != 1) return false;
+    if (ids->ne[0] != 8 || ids->ne[1] < min_tokens || ids->ne[1] > max_tokens || ids->nb[0] != sizeof(int32_t) ||
+            input->ne[0] != inner || (input->ne[1] != 1 && input->ne[1] != 8) ||
+            input->ne[2] != ids->ne[1] || op->ne[0] != output || op->ne[1] != 8 || op->ne[2] != ids->ne[1]) return false;
+    if (!ggml_is_contiguous(weights) || !ggml_is_contiguous(input) || !ggml_is_contiguous(op)) return false;
+    return fits_u32(weights) && fits_u32(input) && fits_u32(ids) && fits_u32(op);
+}
+
+inline bool eligible(const ggml_tensor * op, ggml_metal_device_id device,
+                     bool shared, int rows, int simdgroups) {
+    return eligible_geometry(op, device, shared, rows, simdgroups, 8, 3, 16);
+}
+
+inline bool eligible_r4(const ggml_tensor * op, ggml_metal_device_id device,
+                        bool shared, int rows, int simdgroups) {
+    return eligible_geometry(op, device, shared, rows, simdgroups, 4, 1, 16);
+}
+
+} // namespace ggml_metal_routed_offsets
diff --git a/ggml/src/ggml-metal/ggml-metal-routed-tuning.h b/ggml/src/ggml-metal/ggml-metal-routed-tuning.h
new file mode 100644
index 000000000..d65eb01aa
--- /dev/null
+++ b/ggml/src/ggml-metal/ggml-metal-routed-tuning.h
@@ -0,0 +1,27 @@
+#pragma once
+
+#include "ggml-metal-device.h"
+
+namespace ggml_metal_routed_tuning {
+
+// Reuse the per-lane activation registers across more output rows. Preserve
+// complete SIMDgroup row tiles: the vector bodies load every unrolled row.
+inline int rows(ggml_metal_device_id device, bool shared_buffers, ggml_type type, int64_t inner,
+                int64_t output, int64_t tokens, int nsg, int fallback, int64_t selections = 8) {
+    // Portable screen supports this down-projection shape only. Gate/up
+    // remains faster at the existing width on these two measured devices.
+    if ((device == GGML_METAL_DEVICE_M1_ULTRA || device == GGML_METAL_DEVICE_M4) &&
+            shared_buffers && type == GGML_TYPE_Q4_1 && inner == 512 && output == 2048 &&
+            tokens == 16 && selections == 8 && nsg == 2) {
+        return 8;
+    }
+    if (device != GGML_METAL_DEVICE_M5_MAX || !shared_buffers || tokens < 3 || inner < 512 || inner > 4096 ||
+            output < 512 || tokens > 31 || nsg <= 0) {
+        return fallback;
+    }
+    const int candidate = type == GGML_TYPE_Q4_K ? 4 : type == GGML_TYPE_Q5_K ? 2 :
+            type == GGML_TYPE_Q4_1 ? 8 : fallback;
+    return output % (candidate * nsg) == 0 ? candidate : fallback;
+}
+
+} // namespace ggml_metal_routed_tuning
