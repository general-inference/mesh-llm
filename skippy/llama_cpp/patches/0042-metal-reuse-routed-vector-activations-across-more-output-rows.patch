diff --git a/tests/test-backend-portable-routed.h b/tests/test-backend-portable-routed.h
new file mode 100644
index 000000000..9df3198a1
--- /dev/null
+++ b/tests/test-backend-portable-routed.h
@@ -0,0 +1,43 @@
+#pragma once
+
+// Explicit opt-in native qualification, using the backend suite's actual
+// graph construction, CPU reference, strided views and negative/repeated IDs.
+template<class Parent>
+struct test_portable_routed final : Parent {
+    using Parent::Parent;
+    std::string op_desc(ggml_tensor *) override { return "PORTABLE_ROUTED_REUSE"; }
+};
+
+static std::vector<std::unique_ptr<test_case>> make_portable_routed_cases() {
+    std::vector<std::unique_ptr<test_case>> cases;
+    for (bool broadcast : {false,true}) {
+        for (bool offset : {false,true}) for (bool masked : {false,true}) {
+            cases.emplace_back(new test_portable_routed<test_mul_mat_id>(
+                GGML_TYPE_Q4_1, GGML_TYPE_F32, 16, 8, broadcast, 2048, 16, 512, 0, offset, masked));
+            cases.emplace_back(new test_portable_routed<test_mul_mat_id_dup>(
+                GGML_TYPE_Q4_1, GGML_TYPE_F32, 16, 8, broadcast, 2048, 16, 512, 0, offset, masked));
+        }
+        cases.emplace_back(new test_portable_routed<test_mul_mat_id>(
+            GGML_TYPE_Q4_1, GGML_TYPE_F32, 256, 8, broadcast, 2048, 16, 512, 0, true, true));
+        cases.emplace_back(new test_portable_routed<test_mul_mat_id_dup>(
+            GGML_TYPE_Q4_1, GGML_TYPE_F32, 256, 8, broadcast, 2048, 16, 512, 0, true, true));
+        cases.emplace_back(new test_portable_routed<test_mul_mat_id>(
+            GGML_TYPE_Q4_1, GGML_TYPE_F32, 16, 8, broadcast, 2048, 16, 512, 2080, true, true));
+        for (int tokens : {8,15,17}) {
+            cases.emplace_back(new test_portable_routed<test_mul_mat_id>(
+                GGML_TYPE_Q4_1, GGML_TYPE_F32, 16, 8, broadcast, 2048, tokens, 512));
+        }
+        cases.emplace_back(new test_portable_routed<test_mul_mat_id>(
+            GGML_TYPE_Q4_1, GGML_TYPE_F32, 16, 8, broadcast, 512, 16, 2048));
+    }
+    for (int selected : {4,16}) cases.emplace_back(new test_portable_routed<test_mul_mat_id>(
+        GGML_TYPE_Q4_1, GGML_TYPE_F32, 16, selected, false, 2048, 16, 512));
+    cases.emplace_back(new test_portable_routed<test_mul_mat_id>(
+        GGML_TYPE_Q5_1, GGML_TYPE_F32, 16, 8, false, 2048, 16, 512));
+    cases.emplace_back(new test_portable_routed<test_mul_mat_id>(
+        GGML_TYPE_Q4_1, GGML_TYPE_F32, 16, 8, false, 2032, 16, 512));
+    cases.emplace_back(new test_portable_routed<test_mul_mat_id>(
+        GGML_TYPE_Q4_1, GGML_TYPE_F32, 16, 8, false, 2048, 16, 480));
+    GGML_ASSERT(cases.size() == 35);
+    return cases;
+}
