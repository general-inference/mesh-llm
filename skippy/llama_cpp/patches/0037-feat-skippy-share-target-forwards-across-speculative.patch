+// Different prompts and rejection points must leave both lanes independent.
+void speculate_shared(const char * path, uint32_t depth) {
+    auto * model = open(path, depth, 2);
+    const std::vector<llama_token> prompts[2] = {PROMPT, {1, 6, 10, 2, 8, 11, 3, 13}};
+    const Reference expected[2] = {reference(model, prompts[0]), reference(model, prompts[1])};
+    skippy_session * sessions[2] = {create(model), create(model)};
+    size_t committed[2] = {};
+    llama_token current[2] = {prompts[0].back(), prompts[1].back()};
+    for (size_t lane = 0; lane < 2; ++lane) {
+        prefill(sessions[lane], std::vector<llama_token>(prompts[lane].begin(), prompts[lane].end() - 1));
+    }
+    for (size_t step = 0; step < 8; ++step) {
+        std::vector<llama_token> inputs[2];
+        std::vector<llama_token> outputs[2] = {std::vector<llama_token>(WINDOW), std::vector<llama_token>(WINDOW)};
+        size_t counts[2] = {};
+        skippy_verify_request requests[2];
+        for (size_t lane = 0; lane < 2; ++lane) {
+            const auto reject = REJECTIONS[(step + lane) % (sizeof(REJECTIONS) / sizeof(REJECTIONS[0]))];
+            inputs[lane] = window_of(current[lane], expected[lane].tokens, committed[lane], WINDOW - 1, reject);
+            requests[lane] = {sessions[lane], inputs[lane].data(), WINDOW, nullptr,
+                    outputs[lane].data(), WINDOW, &counts[lane]};
+        }
+        if (step == 0) {
+            const int32_t before[2] = {sessions[0]->n_past, sessions[1]->n_past};
+            const auto saved = requests[1].session;
+            requests[1].session = requests[0].session;
+            skippy_error * error = nullptr;
+            CHECK(skippy_verify_batch_sampled(requests, 2, &error) == SKIPPY_STATUS_INVALID_ARGUMENT);
+            skippy_error_free(error);
+            requests[1].session = saved;
+            CHECK(sessions[0]->n_past == before[0] && sessions[1]->n_past == before[1]);
+            requests[1].token_count = WINDOW - 1;
+            error = nullptr;
+            CHECK(skippy_verify_batch_sampled(requests, 2, &error) == SKIPPY_STATUS_INVALID_ARGUMENT);
+            skippy_error_free(error);
+            requests[1].token_count = WINDOW;
+            CHECK(sessions[0]->n_past == before[0] && sessions[1]->n_past == before[1]);
+        }
+        skippy_error * error = nullptr;
+        ok(skippy_verify_batch_sampled(requests, 2, &error), error);
+        for (size_t lane = 0; lane < 2; ++lane) {
+            CHECK(counts[lane] > 0 && counts[lane] <= WINDOW);
+            for (size_t row = 0; row < counts[lane]; ++row) {
+                CHECK(outputs[lane][row] == expected[lane].tokens[committed[lane] + row]);
+            }
+            const uint64_t base = prompts[lane].size() - 1 + committed[lane];
+            error = nullptr;
+            if (counts[lane] == WINDOW) {
+                ok(skippy_retire_verify_checkpoint(sessions[lane], base, WINDOW, &error), error);
+            } else {
+                ok(skippy_trim_session(sessions[lane], base + counts[lane], &error), error);
+            }
+            committed[lane] += counts[lane];
+            current[lane] = outputs[lane][counts[lane] - 1];
+        }
+    }
+    for (size_t lane = 0; lane < 2; ++lane) {
+        CHECK(decode(sessions[lane], current[lane]) == expected[lane].tokens[committed[lane]]);
+        skippy_error * error = nullptr;
+        ok(skippy_session_free(sessions[lane], &error), error);
+    }
+    release(model);
+}
+
 } // namespace
 
