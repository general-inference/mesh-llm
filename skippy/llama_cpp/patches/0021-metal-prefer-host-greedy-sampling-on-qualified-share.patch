From bb1dbdd0e98add2bb5a9046b163ea2f3f45bb387 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Sat, 14 Nov 2026 20:05:07 +1100
Subject: [PATCH] metal: prefer host greedy sampling on qualified shared-memory
 devices

---
 ggml/src/ggml-metal/ggml-metal-tuning.cpp |  4 ++++
 ggml/src/ggml-metal/ggml-metal-tuning.h   |  5 +++++
 ggml/src/ggml-metal/ggml-metal.cpp        |  8 ++++++++
 src/skippy/sampling.cpp                   | 19 +++++++++++++++++++
 tests/test-metal-graph-optimize.cpp       | 13 ++++++++++++-
 5 files changed, 48 insertions(+), 1 deletion(-)

diff --git a/ggml/src/ggml-metal/ggml-metal-tuning.cpp b/ggml/src/ggml-metal/ggml-metal-tuning.cpp
index 0fe50277e..f8ff94114 100644
--- a/ggml/src/ggml-metal/ggml-metal-tuning.cpp
+++ b/ggml/src/ggml-metal/ggml-metal-tuning.cpp
@@ -6,6 +6,10 @@
 
 namespace ggml_metal_tuning {
 
+bool prefer_host_greedy(ggml_metal_device_id device, bool shared_buffers) {
+    return device == GGML_METAL_DEVICE_M5_MAX && shared_buffers;
+}
+
 int fa_vec_ne11_bucket(int64_t ne11) {
     for (int i = 0; i < (int) std::size(FA_VEC_NE11_BUCKETS); ++i) {
         if (ne11 < FA_VEC_NE11_BUCKETS[i]) {
diff --git a/ggml/src/ggml-metal/ggml-metal-tuning.h b/ggml/src/ggml-metal/ggml-metal-tuning.h
index d36a0b639..3d858b56f 100644
--- a/ggml/src/ggml-metal/ggml-metal-tuning.h
+++ b/ggml/src/ggml-metal/ggml-metal-tuning.h
@@ -1,12 +1,17 @@
 #pragma once
 
 #include "ggml.h"
+#include "ggml-metal-device.h"
 
 #include <cstdint>
 #include <vector>
 
 namespace ggml_metal_tuning {
 
+// Qualified on M5 Max with shared graph buffers; leave other devices and
+// private-buffer configurations on their existing sampling path.
+bool prefer_host_greedy(ggml_metal_device_id device, bool shared_buffers);
+
 // FA vec selection buckets. ne01 (query rows) splits decode (==1) from batch (>=2), the
 // batch side refined into {2,3,4,5}: Q>1 reuses one K/V load across rows, so it only pays
 // off once ne01 aligns with Q. ne11 (KV length) is bucketed too, as the Q>1 crossover is
diff --git a/ggml/src/ggml-metal/ggml-metal.cpp b/ggml/src/ggml-metal/ggml-metal.cpp
index 528853974..af98a872e 100644
--- a/ggml/src/ggml-metal/ggml-metal.cpp
+++ b/ggml/src/ggml-metal/ggml-metal.cpp
@@ -1012,7 +1012,15 @@ static void ggml_backend_metal_fusion_set_enabled(ggml_backend_fusion_t finfo, b
     ggml_metal_fusion_info_set_enabled((struct ggml_metal_fusion_info *) finfo, enabled);
 }
 
+static bool ggml_backend_metal_prefers_host_greedy(ggml_backend_dev_t dev) {
+    const auto * props = ggml_metal_device_get_props((ggml_metal_device_t) dev->context);
+    return ggml_metal_tuning::prefer_host_greedy(props->device_id, props->use_shared_buffers);
+}
+
 static void * ggml_backend_metal_get_proc_address(ggml_backend_reg_t reg, const char * name) {
+    if (strcmp(name, "ggml_backend_dev_prefers_host_greedy") == 0) {
+        return (void *) ggml_backend_metal_prefers_host_greedy;
+    }
     if (strcmp(name, "ggml_backend_get_features") == 0) {
         return (void *)ggml_backend_metal_get_features;
     }
diff --git a/src/skippy/sampling.cpp b/src/skippy/sampling.cpp
index b688fce73..ee3f3699f 100644
--- a/src/skippy/sampling.cpp
+++ b/src/skippy/sampling.cpp
@@ -9,6 +9,7 @@
 #include "skippy/speculative_internal.h"
 
 #include "llama-impl.h"
+#include "llama-model.h"
 #include "../vendor/nlohmann/json.hpp"
 
 #include <algorithm>
@@ -544,6 +545,21 @@ static bool skippy_ensure_plain_sampling_chain(
     return true;
 }
 
+static bool skippy_backend_prefers_host_greedy(const skippy_session * session) {
+    if (!session->stage_model || !session->stage_model->model) {
+        return false;
+    }
+    auto * dev = session->stage_model->model->dev_output();
+    auto * reg = dev ? ggml_backend_dev_backend_reg(dev) : nullptr;
+    if (!reg) {
+        return false;
+    }
+    using preference_fn = bool (*)(ggml_backend_dev_t);
+    auto preference = (preference_fn) ggml_backend_reg_get_proc_address(
+            reg, "ggml_backend_dev_prefers_host_greedy");
+    return preference && preference(dev);
+}
+
 void skippy_refresh_backend_sampling(
         skippy_session * session,
         const skippy_sampling_config * sampling) {
@@ -557,6 +573,9 @@ void skippy_refresh_backend_sampling(
         // must likewise never be re-attached.
         return;
     }
+    if (session->ctx && skippy_backend_prefers_host_greedy(session)) {
+        return;
+    }
     session->sampling_backend_enabled = false;
     if (session->ctx != nullptr &&
             // Activation-export and embedding contexts require every output
diff --git a/tests/test-metal-graph-optimize.cpp b/tests/test-metal-graph-optimize.cpp
index 29e700cd8..e9ebdb8df 100644
--- a/tests/test-metal-graph-optimize.cpp
+++ b/tests/test-metal-graph-optimize.cpp
@@ -7,6 +7,7 @@
 #include "ggml-metal-common.h"
 #include "ggml-metal-device.h"
 #include "ggml-metal-fusion.h"
+#include "ggml-metal-tuning.h"
 
 #include <cstdio>
 #include <vector>
@@ -342,12 +343,22 @@ static int run_unary_mul_cases() {
 }
 
 int main() {
+    int preference_failures = 0;
+    for (auto device : { GGML_METAL_DEVICE_M5_MAX, GGML_METAL_DEVICE_M5_PRO,
+                         GGML_METAL_DEVICE_M4_MAX, GGML_METAL_DEVICE_GENERIC }) {
+        for (bool shared : { false, true }) {
+            const bool expected = device == GGML_METAL_DEVICE_M5_MAX && shared;
+            const bool ok = ggml_metal_tuning::prefer_host_greedy(device, shared) == expected;
+            std::printf("host greedy preference: device=%d shared=%d: %s\n", device, shared, ok ? "OK" : "FAIL");
+            preference_failures += !ok;
+        }
+    }
     const std::vector<device_case> devices = {
         { "native simdgroup matrices",       true,  true },
         { "probed or no simdgroup matrices", false, true },
     };
     const int failures = run_pack_cases(devices) + (check_chained_pack_reader() ? 0 : 1) + run_row_independent_pack_cases() +
-        (check_encoder_skips_weight_residual() ? 0 : 1) + run_unary_mul_cases();
+        (check_encoder_skips_weight_residual() ? 0 : 1) + run_unary_mul_cases() + preference_failures;
 
     return failures == 0 ? 0 : 1;
 }
