+// DSpine code bridge: gated predecessor-message write after an active layer.
+//
+// After each draft layer, each block row receives a gated message computed from
+// its predecessor row's codes, carrying the causal chain through depth while the
+// block is still drafted in parallel. The write fuses the next layer's input
+// RMSNorm (the final norm on the last layer).
+//
+// Reference: tencent/dspine (Apache-2.0), arXiv 2609.36173.
+struct dspine_stash {
+    ggml_tensor * raw   = nullptr; // [n_embd, n_tokens] pre-write residual stream
+    ggml_tensor * rms   = nullptr; // [1,      n_tokens] per-row RMS of raw
+    ggml_tensor * query = nullptr; // [rank,   n_tokens] receiver query projection
+};
+
+static void build_dspine_bridge(
+        llm_graph_context & g,
+        const llama_model & model,
+        ggml_tensor * hidden,      // [n_embd, n_tokens] residual stream after layer il
+        ggml_tensor * tokens,      // [n_tokens] block token ids (anchor at each block start)
+        int il,
+        int n_layer,
+        ggml_tensor * next_norm_w, // next layer's attn_norm, or output_norm on the last layer
+        ggml_tensor *& out,        // updated residual stream
+        ggml_tensor *& normed,     // next layer's pre-normed input
+        dspine_stash * stash) {
+    ggml_context * ctx0 = g.ctx0;
+
+    const auto & hparams = g.hparams;
+
+    const int64_t n_embd   = hidden->ne[0];
+    const int64_t n_tokens = hidden->ne[1];
+
+    const int64_t C   = hparams.dspine_code_size;
+    const int64_t R   = hparams.dspine_rank;
+    const float   eps = hparams.dspine_eps;
+
+    const int64_t n_blocks = g.ubatch.n_seqs_unq;
+    GGML_ASSERT(n_blocks > 0 && n_tokens % n_blocks == 0);
+    const int64_t block_size = n_tokens / n_blocks;
+    if (block_size < 2 || block_size > (int64_t) hparams.dflash_block_size) {
+        // probe/chunked shapes carry no mask rows: the bridge message is
+        // identically zero, fall back to the plain residual handoff
+        out    = hidden;
+        normed = nullptr;
+        if (stash) {
+            stash->raw = nullptr;
+            stash->rms = nullptr;
+            stash->query = nullptr;
+        }
+        return;
+    }
+
+    // raw/rms of the residual stream, fp32
+    ggml_tensor * raw = ggml_cont_2d(ctx0, hidden, n_embd, n_tokens);
+    ggml_tensor * rms = ggml_sqrt(ctx0,
+            ggml_clamp(ctx0, ggml_mean(ctx0, ggml_sqr(ctx0, raw)), 1.1754943508222875e-38f, INFINITY));
+
+    ggml_tensor * normalized = ggml_div(ctx0, raw,
+            ggml_add(ctx0, rms, ggml_fill(ctx0, ggml_new_tensor_1d(ctx0, GGML_TYPE_F32, 1), eps)));
+
+    // codes: per-row L2-normalized read projection, scaled to norm sqrt(C)
+    ggml_tensor * read_w = il + 1 == n_layer
+        ? model.dspine_read_w
+        : ggml_view_2d(ctx0, model.dspine_early_read_w, n_embd, C,
+                model.dspine_early_read_w->nb[1], il * model.dspine_early_read_w->nb[2]);
+    ggml_tensor * projected = ggml_mul_mat(ctx0, ggml_cast(ctx0, ggml_cont(ctx0, read_w), GGML_TYPE_F32), normalized);
+
+    ggml_tensor * norm = ggml_sqrt(ctx0, ggml_sum_rows(ctx0, ggml_sqr(ctx0, projected))); // [1, n_tokens]
+    ggml_tensor * codes = ggml_scale(ctx0,
+            ggml_div(ctx0, projected,
+                ggml_add(ctx0, norm, ggml_fill(ctx0, ggml_new_tensor_1d(ctx0, GGML_TYPE_F32, 1), eps))),
+            sqrtf((float) C));
+
+    // anchor rows read the token codebook instead of the read projection
+    ggml_tensor * anchor_codes = ggml_scale(ctx0,
+            ggml_cast(ctx0, ggml_get_rows(ctx0, model.dspine_codebook, tokens), GGML_TYPE_F32), sqrtf(C));
+
+    ggml_tensor * one      = ggml_fill(ctx0, ggml_new_tensor_3d(ctx0, GGML_TYPE_F32, 1, 1, n_blocks), 1.0f);
+    ggml_tensor * zero     = ggml_fill(ctx0, ggml_new_tensor_3d(ctx0, GGML_TYPE_F32, block_size - 1, 1, n_blocks), 0.0f);
+    ggml_tensor * is_anchor = ggml_reshape_2d(ctx0, ggml_concat(ctx0, one, zero, 0), 1, n_tokens);
+    ggml_tensor * ones      = ggml_fill(ctx0, ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, 1, n_tokens), 1.0f);
+    ggml_tensor * not_anchor = ggml_sub(ctx0, ones, is_anchor);
+
+    codes = ggml_add(ctx0, ggml_mul(ctx0, codes, not_anchor), ggml_mul(ctx0, anchor_codes, is_anchor));
+
+    // [Q | S | V] projections of the codes
+    ggml_tensor * q = ggml_mul_mat(ctx0, ggml_cast(ctx0, model.dspine_gate_w,      GGML_TYPE_F32), codes); // [R, n_tokens]
+    ggml_tensor * s = ggml_mul_mat(ctx0, ggml_cast(ctx0, model.dspine_pred_gate_w, GGML_TYPE_F32), codes);
+    ggml_tensor * v = ggml_mul_mat(ctx0, ggml_cast(ctx0, model.dspine_prev_w,      GGML_TYPE_F32), codes);
+
+    if (stash) {
+        stash->raw   = raw;
+        stash->rms   = rms;
+        stash->query = q;
+    }
+
+    // predecessor features: shift one row forward within each block
+    auto shift_rows = [&](ggml_tensor * x) {
+        x = ggml_reshape_3d(ctx0, x, R, block_size, n_blocks);
+        ggml_tensor * prev = ggml_view_3d(ctx0, x, R, block_size - 1, n_blocks, x->nb[1], x->nb[2], 0);
+        ggml_tensor * pad  = ggml_fill(ctx0, ggml_new_tensor_3d(ctx0, GGML_TYPE_F32, R, 1, n_blocks), 0.0f);
+        return ggml_reshape_2d(ctx0, ggml_concat(ctx0, pad, prev, 1), R, n_tokens);
+    };
+
+    // message[i] = sigmoid(q[i] + s[i-1] + b) * v[i-1]; the shifted zero row
+    // keeps anchor rows unchanged without an explicit mask
+    ggml_tensor * gate_b = ggml_reshape_2d(ctx0, ggml_cast(ctx0, model.dspine_gate_b, GGML_TYPE_F32), R, 1);
+    ggml_tensor * message = ggml_mul(ctx0,
+            ggml_sigmoid(ctx0, ggml_add(ctx0, ggml_add(ctx0, q, shift_rows(s)), gate_b)),
+            shift_rows(v));
+
+    ggml_tensor * write_w = ggml_view_2d(ctx0, model.dspine_write_w, R, n_embd,
+            model.dspine_write_w->nb[1], il * model.dspine_write_w->nb[2]);
+    ggml_tensor * delta = ggml_mul_mat(ctx0, ggml_cast(ctx0, ggml_cont(ctx0, write_w), GGML_TYPE_F32), message); // [n_embd, n_tokens]
+
+    out = ggml_add(ctx0, raw, ggml_mul(ctx0, delta, rms));
+
+    // fuse the next layer's input RMSNorm (the final norm on the last layer)
+    normed = g.build_norm(out, next_norm_w, nullptr, LLM_NORM_RMS, -1);
+    g.cb(normed, "dspine_normed", il);
+}
+
+// DSpine serial last-write refinement: rebuild the final write in fp32 for every
+// (sender, receiver) candidate pair and pack [K ids | K x K scores] per block row
+// into the nextn output slot, in the same layout the DFlash2 walk consumes.
+//
+// score[i][j][c] = (raw_i * norm_w) . lm_head[cand[i][c]]
+//                + rms_i * (sigmoid(q_i + G_p e_j + b) * (A e_j)) . tg[c]
+// with e = sqrt(C) * codebook[sender_j] and tg[v] = (lm_head[v] * norm_w) @ W_write.
+static void build_dspine_lattice(
+        llm_graph_context & g,
+        const llama_model & model,
+        ggml_tensor * output,   // lm_head [n_embd, n_vocab]
+        ggml_tensor * tokens,   // [n_tokens] block token ids
+        const dspine_stash & stash) {
+    ggml_context * ctx0 = g.ctx0;
+    auto         & res  = g.res;
+
+    const auto & hparams = g.hparams;
+
+    const int64_t n_tokens = g.n_tokens;
+    const int64_t n_embd   = g.n_embd;
+
+    const int64_t K = hparams.dspine_head_topk;
+    const int64_t R = hparams.dspine_rank;
+    const int64_t C = hparams.dspine_code_size;
+
+    const int64_t n_blocks = g.ubatch.n_seqs_unq;
+    GGML_ASSERT(n_blocks > 0 && n_tokens % n_blocks == 0);
+    GGML_ASSERT(res->t_logits->ne[1] == n_tokens);
+    if (!tokens) {
+        return;
+    }
+
+    const int64_t tokens_per_block = n_tokens / n_blocks;
+    const int64_t block_size = std::min<int64_t>(tokens_per_block, hparams.dflash_block_size);
+    GGML_ASSERT(n_embd >= K + K * K);
+
+    if (block_size < 2 || !stash.raw || !stash.rms || !stash.query) {
+        // no mask rows in this batch (probe/chunk): emit an empty lattice
+        ggml_tensor * empty = ggml_fill(ctx0, ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, n_embd, n_tokens), 0.0f);
+        res->t_h_nextn = empty;
+        ggml_build_forward_expand(g.gf, empty);
+        return;
+    }
+
+    const int64_t row_used = K + K * K;
+    const float   sqrt_c   = sqrtf((float) C);
+
+    // top-K candidate ids per row from the refined logits
+    ggml_tensor * candidates = ggml_top_k(ctx0, res->t_logits, K);
+    ggml_tensor * cand_blk   = ggml_reshape_3d(ctx0, candidates, K, block_size, n_blocks);
+
+    // stash views over [.., block_size, n_blocks]
+    ggml_tensor * raw = ggml_reshape_3d(ctx0, stash.raw,   n_embd, block_size, n_blocks);
+    ggml_tensor * rms = ggml_reshape_3d(ctx0, stash.rms,   1,      block_size, n_blocks);
+    ggml_tensor * que = ggml_reshape_3d(ctx0, stash.query, R,      block_size, n_blocks);
+
+    ggml_tensor * norm_w = ggml_cast(ctx0, model.output_norm, GGML_TYPE_F32);
+
+    const int64_t il_last = (int64_t) model.layers.size() - 1;
+    ggml_tensor * write_w = ggml_view_2d(ctx0, model.dspine_write_w, R, n_embd,
+            model.dspine_write_w->nb[1], il_last * model.dspine_write_w->nb[2]);
+    ggml_tensor * write_w_t = ggml_cont(ctx0, ggml_transpose(ctx0,
+                ggml_cast(ctx0, ggml_cont(ctx0, write_w), GGML_TYPE_F32))); // [n_embd, R]
+
+    ggml_tensor * gate_w    = ggml_cast(ctx0, model.dspine_pred_gate_w, GGML_TYPE_F32);
+    ggml_tensor * prev_w    = ggml_cast(ctx0, model.dspine_prev_w,      GGML_TYPE_F32);
+    ggml_tensor * gate_b    = ggml_reshape_4d(ctx0,
+            ggml_cast(ctx0, model.dspine_gate_b, GGML_TYPE_F32), R, 1, 1, 1);
+
+    // a run of rows shares one sender set: [n_pred, n_pos, n_blocks] ids
+    auto score_run = [&](int64_t beg_pos, int64_t n_pos, ggml_tensor * sender_ids) {
+        const int64_t n_pred = sender_ids->ne[0];
+
+        ggml_tensor * cand_run = ggml_cont(ctx0, ggml_view_3d(ctx0, cand_blk, K, n_pos, n_blocks,
+                    cand_blk->nb[1], cand_blk->nb[2], beg_pos * cand_blk->nb[1]));
+
+        // sender codes e = sqrt(C) * codebook[sender]
+        ggml_tensor * e = ggml_reshape_2d(ctx0,
+                ggml_scale(ctx0,
+                    ggml_cast(ctx0,
+                        ggml_get_rows(ctx0, model.dspine_codebook,
+                            ggml_reshape_1d(ctx0, sender_ids, n_pred * n_pos * n_blocks)),
+                        GGML_TYPE_F32),
+                    sqrt_c),
+                C, n_pred * n_pos * n_blocks);
+
+        // sender-side projections: tvg = G_p e, tvv = A e   [R, n_pred, n_pos, n_blocks]
+        ggml_tensor * tvg = ggml_reshape_4d(ctx0, ggml_mul_mat(ctx0, gate_w, e), R, n_pred, n_pos, n_blocks);
+        ggml_tensor * tvv = ggml_reshape_4d(ctx0, ggml_mul_mat(ctx0, prev_w, e), R, n_pred, n_pos, n_blocks);
+
+        // receiver query at the run's rows, broadcast over senders
+        ggml_tensor * q_run = ggml_cont(ctx0, ggml_view_3d(ctx0, que, R, n_pos, n_blocks,
+                    que->nb[1], que->nb[2], beg_pos * que->nb[1]));
+
+        // m = sigmoid(q + tvg + b) * tvv   [R, n_pred, n_pos, n_blocks]
+        ggml_tensor * m = ggml_mul(ctx0,
+                ggml_sigmoid(ctx0,
+                    ggml_add(ctx0,
+                        ggml_add(ctx0, ggml_repeat(ctx0, ggml_reshape_4d(ctx0, q_run, R, 1, n_pos, n_blocks), tvg), tvg),
+                        ggml_repeat(ctx0, gate_b, tvg))),
+                tvv);
+
+        // lm rows for the run's candidates
+        ggml_tensor * lm_c = ggml_reshape_4d(ctx0,
+                ggml_cast(ctx0,
+                    ggml_get_rows(ctx0, output,
+                        ggml_reshape_1d(ctx0, cand_run, K * n_pos * n_blocks)),
+                    GGML_TYPE_F32),
+                n_embd, K, n_pos, n_blocks);
+
+        // tg[c] = (lm_c * norm_w) @ W_write   [R, K, n_pos, n_blocks]
+        ggml_tensor * lm_c_nw = ggml_mul(ctx0, lm_c, ggml_reshape_4d(ctx0, norm_w, n_embd, 1, 1, 1));
+        ggml_tensor * tg = ggml_reshape_4d(ctx0,
+                ggml_mul_mat(ctx0, write_w_t, ggml_reshape_2d(ctx0, lm_c_nw, n_embd, K * n_pos * n_blocks)),
+                R, K, n_pos, n_blocks);
+
+        // s[c, j] = tg[c] . m[j]
+        ggml_tensor * s = ggml_mul_mat(ctx0, tg, m); // [K, n_pred, n_pos, n_blocks]
+
+        // base[c] = (raw * norm_w) . lm_c
+        ggml_tensor * raw_run = ggml_cont(ctx0, ggml_view_3d(ctx0, raw, n_embd, n_pos, n_blocks,
+                    raw->nb[1], raw->nb[2], beg_pos * raw->nb[1]));
+        ggml_tensor * raw_nw = ggml_mul(ctx0, ggml_reshape_4d(ctx0, raw_run, n_embd, 1, n_pos, n_blocks),
+                ggml_reshape_4d(ctx0, norm_w, n_embd, 1, 1, 1));
+        ggml_tensor * base = ggml_sum_rows(ctx0, ggml_mul(ctx0, ggml_repeat(ctx0, raw_nw, lm_c), lm_c)); // [1, K, n_pos, n_blocks]
+
+        // score[c, j] = base[c] + rms * s[c, j]
+        ggml_tensor * rms_run = ggml_cont(ctx0, ggml_view_3d(ctx0, rms, 1, n_pos, n_blocks,
+                    rms->nb[1], rms->nb[2], beg_pos * rms->nb[1]));
+        ggml_tensor * score = ggml_add(ctx0,
+                ggml_repeat(ctx0, ggml_reshape_4d(ctx0, base, K, 1, n_pos, n_blocks), s),
+                ggml_mul(ctx0, ggml_repeat(ctx0, ggml_reshape_4d(ctx0, rms_run, 1, 1, n_pos, n_blocks), s), s));
+
+        if (n_pred == 1) {
+            score = ggml_repeat_4d(ctx0, score, K, K, n_pos, n_blocks);
+        }
+
+        ggml_tensor * row = ggml_concat(ctx0,
+                ggml_cast(ctx0, cand_run, GGML_TYPE_F32),
+                ggml_reshape_3d(ctx0, score, K * K, n_pos, n_blocks), 0);
+        return ggml_pad(ctx0, row, n_embd - row_used, 0, 0, 0);
+    };
+
+    ggml_tensor * packed = ggml_fill(ctx0,
+            ggml_new_tensor_3d(ctx0, GGML_TYPE_F32, n_embd, 1, n_blocks), 0.0f);
+
+    // row 1: the sender is the anchor token, one id per sequence
+    ggml_tensor * anchor_ids = ggml_reshape_3d(ctx0,
+            ggml_cont_1d(ctx0,
+                ggml_view_2d(ctx0, tokens, 1, n_blocks, tokens_per_block * tokens->nb[0], 0), n_blocks),
+            1, 1, n_blocks);
+    packed = ggml_concat(ctx0, packed, score_run(1, 1, anchor_ids), 1);
+
+    if (block_size > 2) {
+        // rows 2..: the sender is the previous row's candidate set
+        ggml_tensor * prev_ids = ggml_cont(ctx0, ggml_view_3d(ctx0, cand_blk, K, block_size - 2, n_blocks,
+                    cand_blk->nb[1], cand_blk->nb[2], cand_blk->nb[1]));
+        packed = ggml_concat(ctx0, packed, score_run(2, block_size - 2, prev_ids), 1);
+    }
+
+    packed = ggml_reshape_2d(ctx0, packed, n_embd, block_size * n_blocks);
+    g.cb(packed, "dspine_lattice", -1);
+    res->t_h_nextn = packed;
+    ggml_build_forward_expand(g.gf, packed);
+}
