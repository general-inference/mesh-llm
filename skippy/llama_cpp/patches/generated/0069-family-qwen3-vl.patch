From 4bed0661e006de194ff7b2111fb80824b0688f57 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH 69/81] skippy: annotate qwen3-vl graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

diff --git a/src/models/qwen3vl.cpp b/src/models/qwen3vl.cpp
index 92ff799a9..46f5548f6 100644
--- a/src/models/qwen3vl.cpp
+++ b/src/models/qwen3vl.cpp
@@ -79,6 +79,8 @@ llama_model_qwen3vl::graph::graph(const llm_graph_params & params) : llm_graph_c
     ggml_tensor * inp_out_ids = build_inp_out_ids();
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         ggml_tensor * inpSA = inpL;
 
         // norm
@@ -147,6 +149,7 @@ llama_model_qwen3vl::graph::graph(const llm_graph_params & params) : llm_graph_c
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
 
     cur = inpL;
