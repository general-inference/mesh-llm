+    {LLM_TENSOR_DSPINE_WRITE_W,             {LLM_TENSOR_LAYER_OUTPUT,    GGML_OP_MUL_MAT}},
+    {LLM_TENSOR_DSPINE_GATE_W,              {LLM_TENSOR_LAYER_OUTPUT,    GGML_OP_MUL_MAT}},
