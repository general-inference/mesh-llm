+static void require(bool ok, const char * why) { if (!ok) throw std::runtime_error(why); }
+static std::atomic<int> compiled{0};
+static std::atomic<int> compiled_r4{0};
+static void logger(ggml_log_level level, const char * text, void *) {
+    if (std::strstr(text, "compiling pipeline: base = 'kernel_mul_mv_id_q4_1_f32_r8_u32'")) ++compiled;
+    if (std::strstr(text, "compiling pipeline: base = 'kernel_mul_mv_id_q4_1_f32_r4_u32'")) ++compiled_r4;
+    if (level != GGML_LOG_LEVEL_DEBUG) std::fputs(text, stderr);
+}
+struct q4 { ggml_fp16_t d, m; uint8_t qs[16]; };
+static_assert(sizeof(q4) == 20, "Q4_1 storage");
+struct storage {
+    ggml_context * ctx = ggml_init({4*1024*1024, nullptr, true});
+    ggml_backend_buffer_t buffer = nullptr;
+    ~storage() { if (buffer) ggml_backend_buffer_free(buffer); if (ctx) ggml_free(ctx); }
+};
