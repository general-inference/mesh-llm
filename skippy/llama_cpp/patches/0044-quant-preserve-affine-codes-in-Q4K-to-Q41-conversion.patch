diff --git a/src/llama-quant-affine.h b/src/llama-quant-affine.h
new file mode 100644
index 000000000..9b5039e36
--- /dev/null
+++ b/src/llama-quant-affine.h
@@ -0,0 +1,42 @@
+#pragma once
+
+#include "../ggml/src/ggml-quants.h"
+
+#include <cmath>
+#include <cstdint>
+
+// Each Q4_K sub-block is already a 32-value affine integer grid. Q4_1 can
+// carry its codes directly, with only the decoded scale/min rounded to f16.
+// Return false when those coefficients cannot be represented finitely.
+inline bool llama_quantize_affine_codes(const void * source, void * destination, int64_t elements) {
+    if (elements < 0 || elements % QK_K != 0) {
+        return false;
+    }
+    const auto * input = static_cast<const block_q4_K *>(source);
+    auto * output = static_cast<block_q4_1 *>(destination);
+    for (int64_t block = 0; block < elements/QK_K; ++block) {
+        const float scale = ggml_fp16_to_fp32(input[block].d);
+        const float minimum = ggml_fp16_to_fp32(input[block].dmin);
+        const uint8_t * packed = input[block].scales;
+        for (int group = 0; group < 8; ++group) {
+            const int scale_code = group < 4 ? packed[group] & 63 :
+                    (packed[group + 4] & 15) | ((packed[group - 4] >> 6) << 4);
+            const int min_code = group < 4 ? packed[group + 4] & 63 :
+                    (packed[group + 4] >> 4) | ((packed[group] >> 6) << 4);
+            auto & result = output[8*block + group];
+            result.d = ggml_fp32_to_fp16(scale*scale_code);
+            result.m = ggml_fp32_to_fp16(-minimum*min_code);
+            if (!std::isfinite(ggml_fp16_to_fp32(result.d)) ||
+                    !std::isfinite(ggml_fp16_to_fp32(result.m))) {
+                return false;
+            }
+            const uint8_t * codes = input[block].qs + 32*(group/2);
+            const int shift = 4*(group%2);
+            for (int index = 0; index < 16; ++index) {
+                result.qs[index] = uint8_t(((codes[index] >> shift) & 15) |
+                        (((codes[index + 16] >> shift) & 15) << 4));
+            }
+        }
+    }
+    return true;
+}
