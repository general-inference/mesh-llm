diff --git a/tests/test-quantize-affine.cpp b/tests/test-quantize-affine.cpp
new file mode 100644
index 000000000..77101df97
--- /dev/null
+++ b/tests/test-quantize-affine.cpp
@@ -0,0 +1,88 @@
+#include "../src/llama-quant-affine.h"
+
+#include <algorithm>
+#include <array>
+#include <cstdio>
+#include <cstring>
+#include <random>
+#include <vector>
+
+static bool check_codes(const block_q4_K & source, const std::array<block_q4_1, 8> & output) {
+    for (int group = 0; group < 8; ++group) {
+        for (int index = 0; index < 32; ++index) {
+            const int before = (source.qs[32*(group/2) + index] >> (4*(group%2))) & 15;
+            const int after = (output[group].qs[index%16] >> (4*(index/16))) & 15;
+            if (before != after) {
+                return false;
+            }
+        }
+    }
+    return true;
+}
+
+int main() {
+    auto * ctx = ggml_init({1024, nullptr, true});
+    if (!ctx) {
+        return 1;
+    }
+    std::mt19937 rng(42);
+    std::normal_distribution<float> normal;
+    double error = 0, energy = 0;
+    int tested = 0;
+    std::vector<block_q4_K> corpus;
+    for (float amplitude : {0.0f, 0.0001f, 0.01f, 1.0f, 100.0f}) {
+        for (int sample = 0; sample < 256; ++sample) {
+            std::array<float, QK_K> weights, before, after;
+            for (float & value : weights) {
+                value = amplitude*normal(rng);
+            }
+            block_q4_K packed;
+            quantize_row_q4_K_ref(weights.data(), &packed, QK_K);
+            corpus.push_back(packed);
+            std::array<block_q4_1, 8> output;
+            if (!llama_quantize_affine_codes(&packed, output.data(), QK_K) || !check_codes(packed, output)) {
+                std::fprintf(stderr, "affine code conversion failed at amplitude=%g sample=%d\n", amplitude, sample);
+                return 1;
+            }
+            dequantize_row_q4_K(&packed, before.data(), QK_K);
+            dequantize_row_q4_1(output.data(), after.data(), QK_K);
+            for (int i = 0; i < QK_K; ++i) {
+                const double delta = double(after[i]) - before[i];
+                error += delta*delta;
+                energy += double(before[i])*before[i];
+            }
+            ++tested;
+        }
+    }
+    block_q4_1 guard;
+    std::memset(&guard, 0xa5, sizeof(guard));
+    std::vector<block_q4_1> combined(corpus.size()*8 + 2, guard);
+    if (!llama_quantize_affine_codes(corpus.data(), combined.data() + 1, int64_t(corpus.size())*QK_K) ||
+            std::memcmp(&combined.front(), &guard, sizeof(guard)) != 0 ||
+            std::memcmp(&combined.back(), &guard, sizeof(guard)) != 0) {
+        std::fprintf(stderr, "multi-block conversion crossed its output bounds\n");
+        return 1;
+    }
+    for (size_t block = 0; block < corpus.size(); ++block) {
+        std::array<block_q4_1, 8> output;
+        std::copy_n(combined.data() + 1 + 8*block, 8, output.data());
+        if (!check_codes(corpus[block], output)) {
+            std::fprintf(stderr, "multi-block conversion changed codes\n");
+            return 1;
+        }
+    }
+    block_q4_K overflow = {};
+    overflow.d = overflow.dmin = ggml_fp32_to_fp16(65504.0f);
+    std::fill(std::begin(overflow.scales), std::end(overflow.scales), uint8_t(255));
+    std::array<block_q4_1, 8> output;
+    if (llama_quantize_affine_codes(&overflow, output.data(), QK_K) ||
+            llama_quantize_affine_codes(&overflow, output.data(), QK_K - 1) ||
+            llama_quantize_affine_codes(&overflow, output.data(), -QK_K)) {
+        std::fprintf(stderr, "invalid coefficient/shape accepted\n");
+        return 1;
+    }
+    const double nmse = error/std::max(energy, 1.0);
+    std::printf("affine code conversion: %d blocks, all codes identical, relative squared error %.9g\n", tested, nmse);
+    ggml_free(ctx);
+    return nmse < 1e-6 ? 0 : 1;
+}
