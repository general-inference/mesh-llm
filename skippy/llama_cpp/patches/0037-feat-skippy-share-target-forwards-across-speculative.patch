+enum skippy_status skippy_iteration_batch_sampled(
+        const struct skippy_iteration_request * requests, size_t request_count,
+        struct skippy_activation_desc * output_descs, void * const * output_payloads,
+        const size_t * output_payload_capacities, size_t * out_output_payload_bytes,
+        size_t * out_sampled_request_indexes, llama_token * out_predicted_tokens,
+        size_t sampled_output_capacity, size_t * out_sampled_output_count,
+        struct skippy_error ** out_error) {
+    return skippy_iteration_batch_impl(requests, request_count, output_descs, output_payloads,
+            output_payload_capacities, out_output_payload_bytes, out_sampled_request_indexes,
+            out_predicted_tokens, sampled_output_capacity, out_sampled_output_count, out_error, false);
+}
+
+enum skippy_status skippy_verify_batch_sampled(
+        const struct skippy_verify_request * requests, size_t request_count,
+        struct skippy_error ** out_error) {
+    if (requests == nullptr || request_count == 0 || requests[0].session == nullptr ||
+            requests[0].session->ctx == nullptr || requests[0].session->stage_model == nullptr) {
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "active verification requests are required");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    const auto * first = requests[0].session;
+    const auto * model = first->stage_model;
+    if (!skippy_model_supports_causal_readout(model) || skippy_emits_activation_frame(first) ||
+            (skippy_runtime_has_stage_plan(&model->config) &&
+             (model->config.layer_start != 0 || model->config.layer_end < llama_model_n_layer(model->model)))) {
+        skippy_set_error(out_error, SKIPPY_STATUS_UNSUPPORTED, "shared verification requires a complete terminal model");
+        return SKIPPY_STATUS_UNSUPPORTED;
+    }
+    const size_t width = requests[0].token_count;
+    const size_t capacity = std::min(first->ctx->n_batch(), first->ctx->n_ubatch());
+    if (width == 0 || request_count > capacity / width) {
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "verification must fit one native microbatch");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    std::vector<skippy_iteration_request> iteration(request_count);
+    for (size_t index = 0; index < request_count; ++index) {
+        const auto & request = requests[index];
+        if (request.token_count != width || request.output_tokens == nullptr ||
+                request.output_capacity < width || request.out_token_count == nullptr ||
+                request.session == nullptr || request.session->n_past < 0 ||
+                width > static_cast<size_t>(std::numeric_limits<int32_t>::max() - request.session->n_past)) {
+            skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "invalid equal-length verification window");
+            return SKIPPY_STATUS_INVALID_ARGUMENT;
+        }
+        const auto status = skippy_require_usable_session(request.session, out_error);
+        if (status != SKIPPY_STATUS_OK) return status;
+        iteration[index] = {request.session, request.token_ids, width, nullptr, 0,
+                request.sampling, nullptr, nullptr, true, nullptr};
+    }
+    const size_t total = width * request_count;
+    std::vector<size_t> indexes(total);
+    std::vector<llama_token> predictions(total);
+    for (size_t index = 0; index < request_count; ++index) *requests[index].out_token_count = 0;
+    size_t count = 0;
+    bool execution_started = false;
+    const auto status = skippy_iteration_batch_impl(iteration.data(), request_count,
+            nullptr, nullptr, nullptr, nullptr, indexes.data(), predictions.data(), total, &count,
+            out_error, true, &execution_started);
+    if (status != SKIPPY_STATUS_OK) {
+        // A partial forward or sampling failure may have changed every lane's
+        // native state. None may continue from a stale Rust/scheduler position.
+        if (execution_started) {
+            for (size_t index = 0; index < request_count; ++index) requests[index].session->reset_required = true;
+        }
+        return status;
+    }
+    for (size_t index = 0; index < count; ++index) {
+        const auto & request = requests[indexes[index]];
+        request.output_tokens[(*request.out_token_count)++] = predictions[index];
+    }
+    return skippy_success(out_error);
+}
+
 enum skippy_status skippy_decode_step_frame_batch_sampled(
         struct skippy_session * const * sessions,
         const llama_token * token_ids,
