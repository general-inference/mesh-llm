diff --git a/ggml/src/ggml-metal/ggml-metal-fusion.cpp b/ggml/src/ggml-metal/ggml-metal-fusion.cpp
index 6766b4bd9..737eb4cf2 100644
--- a/ggml/src/ggml-metal/ggml-metal-fusion.cpp
+++ b/ggml/src/ggml-metal/ggml-metal-fusion.cpp
@@ -815,6 +815,55 @@ static bool ggml_metal_fusion_check_mul_mat_add(
 
 // ---- patterns ------------------------------------------------------------
 
+static bool ggml_metal_fusion_check_unary_mul(
+        const ggml_metal_fusion *,
+        const ggml_tensor * const * nodes,
+        const ggml_cgraph * gf, const int * node_idxs, int idx,
+        ggml_metal_fusion_mode mode) {
+    const ggml_tensor * unary = nodes[0];
+    const ggml_tensor * mul = nodes[1];
+    const auto op = ggml_get_unary_op(unary);
+    if (op != GGML_UNARY_OP_SILU && op != GGML_UNARY_OP_SIGMOID) {
+        return false;
+    }
+    const ggml_tensor * other = mul->src[0] == unary ? mul->src[1] :
+                               mul->src[1] == unary ? mul->src[0] : nullptr;
+    if (!other || !unary->src[0] || ggml_nelements(mul) > INT32_MAX - 255) {
+        return false;
+    }
+    // This pattern permits a scalar gate, unlike the generic equal-shape
+    // chain. Retain its elision and view checks explicitly.
+    const ggml_op ops[] = { GGML_OP_UNARY, GGML_OP_MUL };
+    const int output = node_idxs[idx + 1];
+    if (!ggml_can_fuse_subgraph_ext(gf, node_idxs + idx, 2, ops, &output, 1)) {
+        return false;
+    }
+    const ggml_tensor * tensors[] = { unary->src[0], unary, other, mul };
+    for (const ggml_tensor * tensor : tensors) {
+        if (tensor->type != GGML_TYPE_F32 || !ggml_is_contiguous(tensor) ||
+            (tensor->ne[0] != 1 && tensor->ne[0] != mul->ne[0])) {
+            return false;
+        }
+        for (int d = 1; d < GGML_MAX_DIMS; ++d) {
+            if (tensor->ne[d] != mul->ne[d]) {
+                return false;
+            }
+        }
+    }
+    if (mode == GGML_METAL_FUSION_FULL) {
+        // Equal-shape in-place writes are safe. Partial overlaps and broadcast
+        // inputs aliased with the output could destroy another thread's input.
+        const ggml_tensor * inputs[] = { unary->src[0], other };
+        for (const ggml_tensor * input : inputs) {
+            if (ggml_metal_fusion_overlap(mul, input) &&
+                (mul->data != input->data || !ggml_are_same_shape(mul, input))) {
+                return false;
+            }
+        }
+    }
+    return true;
+}
+
 static const std::vector<ggml_op> ops_norm_mul         = { GGML_OP_NORM, GGML_OP_MUL };
 static const std::vector<ggml_op> ops_norm_mul_add     = { GGML_OP_NORM, GGML_OP_MUL, GGML_OP_ADD };
 static const std::vector<ggml_op> ops_norm_scale       = { GGML_OP_NORM, GGML_OP_SCALE };
@@ -863,6 +912,7 @@ static const std::vector<ggml_op> ops_moe_reduce_8 = {
