+bool ggml_metal_library_has_function(ggml_metal_library_t lib, const char * name) {
+    [lib->lock lock];
+    if (!lib->available_fns) lib->available_fns = [NSMutableDictionary new];
+    NSString * function_name = [NSString stringWithUTF8String:name];
+    NSNumber * cached = lib->available_fns[function_name];
+    if (cached) {
+        const bool found = [cached boolValue];
+        [lib->lock unlock];
+        return found;
+    }
+    bool found = lib->override_fns && [lib->override_fns containsObject:function_name];
+    if (!found && lib->single_library) {
+        found = [[lib->objs[0] functionNames] containsObject:function_name];
+    } else if (!found) {
+        found = lib->fn_to_lib[function_name] != nil;
+    }
+    lib->available_fns[function_name] = @(found);
+    [lib->lock unlock];
+    return found;
