+    preference_failures += rows(GGML_METAL_DEVICE_M5_MAX, false, GGML_TYPE_Q4_K, 2048, 512, 8, 2, 2) != 2;
+    preference_failures += rows(GGML_METAL_DEVICE_M5_MAX, true, GGML_TYPE_Q4_K, 2048, 512, 1, 2, 2) != 2;
+    preference_failures += rows(GGML_METAL_DEVICE_M5_MAX, true, GGML_TYPE_Q5_K, 512, 2048, 2, 2, 1) != 1;
+    preference_failures += rows(GGML_METAL_DEVICE_M5_MAX, true, GGML_TYPE_Q4_K, 2048, 512, 3, 2, 2) != 4;
+    preference_failures += rows(GGML_METAL_DEVICE_M5_MAX, true, GGML_TYPE_Q5_K, 512, 2048, 8, 2, 1) != 2;
+    preference_failures += rows(GGML_METAL_DEVICE_M5_MAX, true, GGML_TYPE_Q4_K, 2048, 768, 24, 2, 2) != 4;
+    preference_failures += rows(GGML_METAL_DEVICE_M4_MAX, true, GGML_TYPE_Q4_K, 2048, 512, 8, 2, 2) != 2;
+    preference_failures += rows(GGML_METAL_DEVICE_M5_PRO, true, GGML_TYPE_Q4_K, 2048, 512, 8, 2, 2) != 2;
+    preference_failures += rows(GGML_METAL_DEVICE_M5_MAX, true, GGML_TYPE_Q4_K, 256, 512, 8, 2, 2) != 2;
+    preference_failures += rows(GGML_METAL_DEVICE_M5_MAX, true, GGML_TYPE_Q4_K, 2048, 514, 8, 2, 2) != 2;
+    preference_failures += rows(GGML_METAL_DEVICE_M5_MAX, true, GGML_TYPE_Q4_K, 2048, 512, 32, 2, 2) != 2;
+    preference_failures += rows(GGML_METAL_DEVICE_M5_MAX, true, GGML_TYPE_Q6_K, 2048, 512, 8, 2, 2) != 2;
+    preference_failures += rows(GGML_METAL_DEVICE_M5_MAX, true, GGML_TYPE_Q4_K, 4096, 512, 31, 2, 2) != 4;
+    preference_failures += rows(GGML_METAL_DEVICE_M5_MAX, true, GGML_TYPE_Q4_K, 4352, 512, 8, 2, 2) != 2;
     for (auto device : { GGML_METAL_DEVICE_M5_MAX, GGML_METAL_DEVICE_M5_PRO,
                          GGML_METAL_DEVICE_M4_MAX, GGML_METAL_DEVICE_GENERIC }) {
         for (bool shared : { false, true }) {
