diff --git a/src/skippy/tests/output_reorder_fixture.cpp b/src/skippy/tests/output_reorder_fixture.cpp
new file mode 100644
index 000000000..4dd53a83d
--- /dev/null
+++ b/src/skippy/tests/output_reorder_fixture.cpp
@@ -0,0 +1,61 @@
+#include "llama-context.h"
+#include "llama-model.h"
+
+#include <utility>
+#include <vector>
+
+bool llama_context::output_reorder_sampler_lifecycle_for_test() {
+    synchronize();
+    auto previous_sampling = std::move(sampling);
+    auto previous_swaps = std::move(output_swaps);
+    auto previous_idxs = std::move(embd_batch_idxs);
+    const auto previous_logits = logits;
+    const auto previous_embd = embd;
+    const auto previous_nextn = embd_nextn;
+    logits = {nullptr, 0};
+    embd = {nullptr, 0};
+    embd_nextn = {nullptr, 0};
+    sampling = {};
+    output_swaps.clear();
+    embd_batch_idxs.clear();
+
+    // A sampler attached after a raw-output forward has no sampling views.
+    // Its presence must not make an already pending row permutation read null.
+    auto * sampler = llama_sampler_init_greedy();
+    sampling.samplers.emplace(0, sampler);
+    output_swaps.push_back({0, 1});
+    output_reorder();
+    bool valid = output_swaps.empty();
+    sampling.samplers.clear();
+    llama_sampler_free(sampler);
+
+    // Conversely, detaching the last sampler must not suppress permutation of
+    // the sampling views that the completed forward actually produced.
+    const size_t width = model.vocab.n_tokens();
+    std::vector<float> scores(2 * width, 0.0f), probs(2 * width, 0.0f);
+    std::vector<llama_token> candidates(2 * width, 0), sampled = {1, 2};
+    scores[0] = 3.0f; scores[width] = 4.0f;
+    probs[0] = 0.25f; probs[width] = 0.75f;
+    candidates[0] = 1; candidates[width] = 2;
+    sampling.logits = {scores.data(), scores.size()};
+    sampling.probs = {probs.data(), probs.size()};
+    sampling.candidates = {candidates.data(), candidates.size()};
+    sampling.sampled = {sampled.data(), sampled.size()};
+    sampling.logits_count = {1, 2};
+    sampling.probs_count = {3, 4};
+    sampling.candidates_count = {5, 6};
+    output_swaps.push_back({0, 1});
+    output_reorder();
+    valid = valid && sampled[0] == 2 && sampled[1] == 1 &&
+            scores[0] == 4.0f && probs[0] == 0.75f && candidates[0] == 2 &&
+            sampling.logits_count[0] == 2 && sampling.probs_count[0] == 4 &&
+            sampling.candidates_count[0] == 6;
+
+    sampling = std::move(previous_sampling);
+    output_swaps = std::move(previous_swaps);
+    embd_batch_idxs = std::move(previous_idxs);
+    logits = previous_logits;
+    embd = previous_embd;
+    embd_nextn = previous_nextn;
+    return valid;
+}
\ No newline at end of file
diff --git a/src/skippy/tests/sampling_history.cpp b/src/skippy/tests/sampling_history.cpp
index 5dbc73ce9..d13ba8be3 100644
--- a/src/skippy/tests/sampling_history.cpp
