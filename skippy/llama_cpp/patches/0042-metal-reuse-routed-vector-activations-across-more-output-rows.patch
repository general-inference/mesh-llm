diff --git a/ggml/src/ggml-metal/ggml-metal-routed-tuning.h b/ggml/src/ggml-metal/ggml-metal-routed-tuning.h
new file mode 100644
index 000000000..d65eb01aa
--- /dev/null
+++ b/ggml/src/ggml-metal/ggml-metal-routed-tuning.h
@@ -0,0 +1,27 @@
+#pragma once
+
+#include "ggml-metal-device.h"
+
+namespace ggml_metal_routed_tuning {
+
+// Reuse the per-lane activation registers across more output rows. Preserve
+// complete SIMDgroup row tiles: the vector bodies load every unrolled row.
+inline int rows(ggml_metal_device_id device, bool shared_buffers, ggml_type type, int64_t inner,
+                int64_t output, int64_t tokens, int nsg, int fallback, int64_t selections = 8) {
+    // Portable screen supports this down-projection shape only. Gate/up
+    // remains faster at the existing width on these two measured devices.
+    if ((device == GGML_METAL_DEVICE_M1_ULTRA || device == GGML_METAL_DEVICE_M4) &&
+            shared_buffers && type == GGML_TYPE_Q4_1 && inner == 512 && output == 2048 &&
+            tokens == 16 && selections == 8 && nsg == 2) {
+        return 8;
+    }
+    if (device != GGML_METAL_DEVICE_M5_MAX || !shared_buffers || tokens < 3 || inner < 512 || inner > 4096 ||
+            output < 512 || tokens > 31 || nsg <= 0) {
+        return fallback;
+    }
+    const int candidate = type == GGML_TYPE_Q4_K ? 4 : type == GGML_TYPE_Q5_K ? 2 :
+            type == GGML_TYPE_Q4_1 ? 8 : fallback;
+    return output % (candidate * nsg) == 0 ? candidate : fallback;
+}
+
+} // namespace ggml_metal_routed_tuning
