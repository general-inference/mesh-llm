From 9acca1f66c4a68c91a4ad736caa80bbeaf99f35f Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH 52/81] skippy: annotate mimo2 graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

diff --git a/src/models/mimo2.cpp b/src/models/mimo2.cpp
index ac36e6664..e91006eb1 100644
--- a/src/models/mimo2.cpp
+++ b/src/models/mimo2.cpp
@@ -101,6 +101,8 @@ llama_model_mimo2::graph::graph(const llm_graph_params & params) : llm_graph_con
     const bool extract_final_inp = (size_t) n_layer < cparams.embeddings_layer_inp.size() && cparams.embeddings_layer_inp[n_layer];
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         res->t_layer_inp[il] = inpL;
 
         ggml_tensor * inpSA = inpL;
@@ -216,6 +218,7 @@ llama_model_mimo2::graph::graph(const llm_graph_params & params) : llm_graph_con
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
 
     cur = inpL;
