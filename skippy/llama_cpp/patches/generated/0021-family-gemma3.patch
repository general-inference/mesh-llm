From 7f415244f787b9ac7ee319807a8563da5a571dbd Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH 21/81] skippy: annotate gemma3 graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

diff --git a/src/models/gemma3.cpp b/src/models/gemma3.cpp
index 9520c3fcf..dd5fd99b1 100644
--- a/src/models/gemma3.cpp
+++ b/src/models/gemma3.cpp
@@ -105,6 +105,8 @@ llama_model_gemma3::graph<iswa>::graph(const llm_graph_params & params) : llm_gr
     ggml_tensor * inp_out_ids = build_inp_out_ids();
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         // norm
         cur = build_norm(inpL, model.layers[il].attn_norm, NULL, LLM_NORM_RMS, il);
         cb(cur, "attn_norm", il);
@@ -175,6 +177,7 @@ llama_model_gemma3::graph<iswa>::graph(const llm_graph_params & params) : llm_gr
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
     cur = inpL;
 
