diff --git a/src/skippy/log_gate.cpp b/src/skippy/log_gate.cpp
new file mode 100644
index 000000000..7a50b5595
--- /dev/null
+++ b/src/skippy/log_gate.cpp
@@ -0,0 +1,95 @@
+#include "skippy/log_gate.h"
+
+#include "llama.h"
+
+#include <atomic>
+#include <cctype>
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+
+namespace skippy::log_gate {
+
+namespace {
+
+std::atomic<int> g_minimum_level{GGML_LOG_LEVEL_WARN};
+ggml_log_callback g_forward = nullptr;
+void * g_forward_user_data = nullptr;
+std::atomic<bool> g_installed{false};
+
+void gate_callback(enum ggml_log_level level, const char * text, void * user_data) {
+    (void) user_data;
+    ggml_log_callback forward = g_forward;
+    if (!forward) {
+        return;
+    }
+    // CONT continues a message that may have been emitted at any level, so it
+    // always forwards.
+    const int minimum = g_minimum_level.load(std::memory_order_relaxed);
+    if (level == GGML_LOG_LEVEL_CONT || level >= minimum) {
+        forward(level, text, g_forward_user_data);
+    }
+}
+
+bool parse_level(const char * value, int & out) {
+    if (!value) {
+        return false;
+    }
+    std::string name(value);
+    for (char & c : name) {
+        c = std::tolower(static_cast<unsigned char>(c));
+    }
+    if (name == "debug") {
+        out = GGML_LOG_LEVEL_DEBUG;
+        return true;
+    }
+    if (name == "info") {
+        out = GGML_LOG_LEVEL_INFO;
+        return true;
+    }
+    if (name == "warn") {
+        out = GGML_LOG_LEVEL_WARN;
+        return true;
+    }
+    if (name == "error") {
+        out = GGML_LOG_LEVEL_ERROR;
+        return true;
+    }
+    return false;
+}
+
+} // namespace
+
+void install_from_environment() {
+    int minimum = GGML_LOG_LEVEL_WARN;
+    if (const char * value = std::getenv("SKIPPY_LOG_LEVEL")) {
+        if (!parse_level(value, minimum)) {
+            std::fprintf(stderr,
+                    "skippy: ignoring invalid SKIPPY_LOG_LEVEL '%s' (expected debug, info, warn, or error); using warn\n",
+                    value);
+            minimum = GGML_LOG_LEVEL_WARN;
+        }
+    }
+    set_level(minimum);
+
+    bool expected = false;
+    if (!g_installed.compare_exchange_strong(expected, true)) {
+        return;
+    }
+    ggml_log_callback previous = nullptr;
+    void * previous_user_data = nullptr;
+    llama_log_get(&previous, &previous_user_data);
+    g_forward = previous;
+    g_forward_user_data = previous_user_data;
+    llama_log_set(gate_callback, nullptr);
+}
+
+void set_level(int minimum_level) {
+    g_minimum_level.store(minimum_level, std::memory_order_relaxed);
+}
+
+int level() {
+    return g_minimum_level.load(std::memory_order_relaxed);
+}
+
+} // namespace skippy::log_gate
diff --git a/src/skippy/log_gate.h b/src/skippy/log_gate.h
new file mode 100644
index 000000000..1750d4a95
--- /dev/null
+++ b/src/skippy/log_gate.h
@@ -0,0 +1,29 @@
+#pragma once
+
+// Process-wide llama/ggml log gate for skippy test binaries and debug hosts.
+//
+// llama.cpp emits construction diagnostics (per-tensor graph dumps in
+// llama_context graph reserve, per-layer cache setup) at DEBUG level through a
+// process-global callback that prints everything it receives. Test binaries
+// that build real graphs would otherwise write gigabytes of near-identical
+// lines into each CTest transcript (Testing/Temporary/LastTest.log). The gate
+// forwards only messages at or above a threshold to the callback that was
+// installed before the gate, so hosts keep their own handler.
+
+namespace skippy::log_gate {
+
+// Install the gate using the threshold named by SKIPPY_LOG_LEVEL
+// (debug|info|warn|error, case-insensitive). Unset or invalid values fall
+// back to warn, the quiet default for test transcripts. Calling this again
+// only updates the threshold; the pre-gate forwarding target is captured
+// exactly once.
+void install_from_environment();
+
+// Change the threshold after installation. Values mirror ggml_log_level
+// (GGML_LOG_LEVEL_DEBUG..GGML_LOG_LEVEL_ERROR).
+void set_level(int minimum_level);
+
+// Current threshold.
+int level();
+
+} // namespace skippy::log_gate
