--- /dev/null
+++ b/src/llama-memory-recurrent-copy.cpp
@@ -0,0 +1,96 @@
+#include "llama-memory-recurrent-copy.h"
+#include "llama-memory-recurrent.h"
+#include "ggml-backend.h"
+
+#include <cstring>
+
+void llama_recurrent_copy_rows(
+        const std::vector<ggml_tensor *> & tensors,
+        const std::vector<std::vector<llama_recurrent_copy_row>> & groups,
+        std::vector<uint8_t> & scratch) {
+    for (auto * tensor : tensors) {
+        if (!tensor || !tensor->buffer) {
+            continue;
+        }
+        const size_t row_bytes = ggml_row_size(tensor->type, tensor->ne[0]);
+        for (const auto & rows : groups) {
+            if (rows.empty()) continue;
+            const size_t needed = rows.size() * row_bytes;
+            if (scratch.size() < needed) scratch.resize(needed);
+            for (size_t i = 0; i < rows.size(); ++i) {
+                const auto & row = rows[i];
+                GGML_ASSERT(row.destination < tensor->ne[1]);
+                auto * output = scratch.data() + i * row_bytes;
+                if (row.zero) {
+                    std::memset(output, 0, row_bytes);
+                } else {
+                    GGML_ASSERT(row.source < tensor->ne[1]);
+                    ggml_backend_tensor_get(tensor, output, row.source * tensor->nb[1], row_bytes);
+                }
+            }
+            for (size_t i = 0; i < rows.size(); ++i) {
+                ggml_backend_tensor_set(tensor, scratch.data() + i * row_bytes,
+                        rows[i].destination * tensor->nb[1], row_bytes);
+            }
+        }
+    }
+}
+
+void llama_memory_recurrent::preserve_peer_rollback(uint32_t first, uint32_t last, uint32_t n_seqs) {
+    std::vector<uint32_t> pending(last - first + 1, 0);
+    bool preserve = false;
+    for (uint32_t i = first; i <= last; ++i) {
+        auto & cell = cells[i];
+        if (cell.seq_id.empty()) {
+            cell.rs_max = 0;
+        } else {
+            const auto seq = *cell.seq_id.begin();
+            if (seq >= 0 && (size_t) seq < rs_idx.size()) {
+                pending[i - first] = rs_idx[seq];
+            }
+        }
+        if (i < first + n_seqs) {
+            continue; // the new forward replaces active lanes' snapshot history
+        }
+        const uint32_t consumed = pending[i - first];
+        GGML_ASSERT(consumed <= cell.rs_max);
+        cell.rs_max -= consumed;
+        preserve |= cell.rs_max > 0 && (cell.src0 != (int32_t) i || consumed > 0);
+    }
+    if (!preserve) {
+        return;
+    }
+
+    // Moving an inactive lane's current state alone loses its live snapshots.
+    // Materialize the whole working range first, including pending rollbacks,
+    // so a snapshot write cannot clobber an active lane's source state.
+    std::vector<std::vector<llama_recurrent_copy_row>> groups(n_rs_seq + 1);
+    for (uint32_t i = first; i <= last; ++i) {
+        const auto & cell = cells[i];
+        const uint32_t consumed = pending[i - first];
+        groups[0].push_back({(uint32_t) cell.src0 + consumed * size, i, cell.src0 == rs_z});
+        if (i < first + n_seqs || (cell.src0 == (int32_t) i && consumed == 0)) {
+            continue;
+        }
+        for (uint32_t plane = 1; plane <= cell.rs_max; ++plane) {
+            groups[plane].push_back({(uint32_t) cell.src0 + (consumed + plane) * size, i + plane * size});
+        }
+    }
+    // Each plane is gathered before it is written. Pending rollback only
+    // shifts snapshots towards earlier planes, so ascending groups are safe.
+    llama_recurrent_copy_rows(r_l, groups, rollback_copy_scratch);
+    llama_recurrent_copy_rows(s_l, groups, rollback_copy_scratch);
+    llama_recurrent_copy_rows(p_l, groups, rollback_copy_scratch);
+    for (uint32_t i = first; i <= last; ++i) {
+        auto & cell = cells[i];
+        cell.src0 = i;
+        for (const auto seq : cell.seq_id) {
+            if (seq >= 0 && (size_t) seq < rs_idx.size()) {
+                rs_idx[seq] = 0;
+            }
+        }
+    }
+    // New/empty rows were zero-filled above. The old zero source may now be
+    // a materialized destination and must not be cleared by the graph.
+    rs_z = -1;
+}
