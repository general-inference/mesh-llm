From 0d31ae0fd6d5b77e22c1a4acbdcbd863d327b7db Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH 56/81] skippy: annotate mistral-small--mistral3 graph
 semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

diff --git a/src/models/mistral3.cpp b/src/models/mistral3.cpp
index ab8121863..92acbc484 100644
--- a/src/models/mistral3.cpp
+++ b/src/models/mistral3.cpp
@@ -165,6 +165,8 @@ llama_model_mistral3::graph::graph(const llm_graph_params & params) : llm_graph_
     ggml_tensor * inp_out_ids = build_inp_out_ids();
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         ggml_tensor * inpSA = inpL;
 
         // norm
@@ -263,6 +265,7 @@ llama_model_mistral3::graph::graph(const llm_graph_params & params) : llm_graph_
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
     cur = inpL;
 
