diff --git a/ggml/src/ggml-metal/ggml-metal-ops.cpp b/ggml/src/ggml-metal/ggml-metal-ops.cpp
index 5c93bc4f0..13fab80bb 100644
--- a/ggml/src/ggml-metal/ggml-metal-ops.cpp
+++ b/ggml/src/ggml-metal/ggml-metal-ops.cpp
@@ -821,6 +821,29 @@ int ggml_metal_op_acc(ggml_metal_op_t ctx, int idx) {
 int ggml_metal_op_unary(ggml_metal_op_t ctx, int idx) {
     ggml_tensor * op = ctx->node(idx);
 
+    if (op->op == GGML_OP_UNARY && ctx->use_fusion()) {
+        int n = 1;
+        const auto * fusion = ctx->can_fuse(idx, GGML_METAL_FUSION_FULL, &n);
+        if (fusion && ggml_metal_fusion_get_id(fusion) == GGML_METAL_FUSION_UNARY_MUL) {
+            ggml_tensor * mul = ctx->node(idx + n - 1);
+            ggml_tensor * other = mul->src[0] == op ? mul->src[1] : mul->src[0];
+            ggml_metal_kargs_unary_mul args = {
+                (uint64_t) ggml_nelements(mul), (int32_t) mul->ne[0],
+                (int32_t) op->src[0]->ne[0], (int32_t) other->ne[0],
+            };
+            const auto pipeline = ggml_metal_library_get_pipeline_unary_mul(ctx->lib, op);
+            const int nth = std::min(256, ggml_metal_pipeline_max_theads_per_threadgroup(pipeline));
+            ggml_metal_encoder_set_pipeline(ctx->enc, pipeline);
+            ggml_metal_encoder_set_bytes(ctx->enc, &args, sizeof(args), 0);
+            ggml_metal_encoder_set_buffer(ctx->enc, ggml_metal_get_buffer_id(op->src[0]), 1);
+            ggml_metal_encoder_set_buffer(ctx->enc, ggml_metal_get_buffer_id(other), 2);
+            ggml_metal_encoder_set_buffer(ctx->enc, ggml_metal_get_buffer_id(mul), 3);
+            ggml_metal_encoder_dispatch_threadgroups(ctx->enc, (args.n + nth - 1)/nth, 1, 1, nth, 1, 1);
+            ctx->count_fusions(fusion);
+            return n;
+        }
+    }
+
     // the sigmoid and sqrt(softplus) TOPK_MOE fusions anchor at the gating unary node
     if (op->op == GGML_OP_UNARY && ctx->use_fusion() &&
         (ggml_get_unary_op(op) == GGML_UNARY_OP_SOFTPLUS || ggml_get_unary_op(op) == GGML_UNARY_OP_SIGMOID)) {
diff --git a/ggml/src/ggml-metal/kernels/unary.metal b/ggml/src/ggml-metal/kernels/unary.metal
index b361da996..8ccb689fc 100644
--- a/ggml/src/ggml-metal/kernels/unary.metal
+++ b/ggml/src/ggml-metal/kernels/unary.metal
@@ -3,6 +3,30 @@
 constant short FC_unary_op [[function_constant(FC_UNARY + 0)]];
 constant bool  FC_unary_cnt[[function_constant(FC_UNARY + 1)]];
 
+// Keep the unary result as f32 before multiplying, just as the two unfused
+// kernels do. Only dim 0 can broadcast; all other dimensions share row order.
+template <bool silu>
+kernel void kernel_unary_mul_f32(
+        constant ggml_metal_kargs_unary_mul & args,
+        device const float * src0,
+        device const float * src1,
+        device float * dst,
+        uint i [[thread_position_in_grid]]) {
+    if (i >= args.n) {
+        return;
+    }
+    const uint row = i / args.width;
+    const uint col = i % args.width;
+    const float x = src0[row * args.unary_width + (args.unary_width == 1 ? 0 : col)];
+    const float y = src1[row * args.other_width + (args.other_width == 1 ? 0 : col)];
+    const float activated = (silu ? x : 1.0f) / (1.0f + exp(-x));
+    dst[i] = activated * y;
+}
+
+typedef decltype(kernel_unary_mul_f32<true>) kernel_unary_mul_f32_t;
+template [[host_name("kernel_unary_mul_silu_f32")]] kernel kernel_unary_mul_f32_t kernel_unary_mul_f32<true>;
+template [[host_name("kernel_unary_mul_sigmoid_f32")]] kernel kernel_unary_mul_f32_t kernel_unary_mul_f32<false>;
+
 template <typename T, typename U>
 inline constexpr T ggml_metal_unary_cast(U x) {
     return (T) x;
diff --git a/tests/test-metal-graph-optimize.cpp b/tests/test-metal-graph-optimize.cpp
index c46987b12..29e700cd8 100644
--- a/tests/test-metal-graph-optimize.cpp
+++ b/tests/test-metal-graph-optimize.cpp
@@ -273,13 +273,81 @@ static bool check_chained_pack_reader() {
     return report_reader("reader of a chained MUL_MAT+ADD sum", packed, after);
 }
 
+static bool check_unary_mul(ggml_unary_op op, bool gate, bool swap, bool reuse, bool capture, bool strided,
+                            ggml_type type = GGML_TYPE_F32, int alias = 0) {
+    ggml_init_params params = { n_tensors*ggml_tensor_overhead() + ggml_graph_overhead(), nullptr, true };
+    ggml_context * ctx = ggml_init(params);
+    ggml_tensor * input = ggml_new_tensor_2d(ctx, type, gate ? 1 : 32, 4);
+    if (strided) {
+        ggml_tensor * padded = ggml_new_tensor_2d(ctx, type, 64, 4);
+        input = ggml_view_2d(ctx, padded, 32, 4, padded->nb[1], 0);
+    }
+    ggml_tensor * unary = ggml_unary(ctx, input, op);
+    if (capture) {
+        ggml_set_output(unary);
+    }
+    ggml_tensor * other = ggml_new_tensor_2d(ctx, type, gate ? 32 : input->ne[0], input->ne[1]);
+    ggml_tensor * mul = gate || swap ? ggml_mul(ctx, other, unary) : ggml_mul(ctx, unary, other);
+    ggml_cgraph * graph = ggml_new_graph(ctx);
+    ggml_build_forward_expand(graph, mul);
+    if (reuse) {
+        ggml_build_forward_expand(graph, ggml_add(ctx, unary, unary));
+    }
+    const auto buft = ggml_backend_dev_buffer_type(ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_GPU));
+    auto buffer = ggml_backend_alloc_ctx_tensors_from_buft(ctx, buft);
+    if (alias) {
+        // Structural checks only: overlapping storage must not turn a scalar
+        // broadcast or a shifted vector into an unsafe in-place kernel.
+        mul->data = (char *) input->data + (alias == 2 ? sizeof(float) : 0);
+    }
+    std::vector<int> idxs;
+    for (int i = 0; i < ggml_graph_n_nodes(graph); ++i) {
+        if (!ggml_op_is_empty(ggml_graph_node(graph, i)->op)) {
+            idxs.push_back(i);
+        }
+    }
+    int count = 1;
+    const auto * fusion = ggml_metal_fusion_next(graph, idxs.data(), idxs.size(), 0,
+                                                GGML_METAL_FUSION_FULL, &count);
+    const bool fused = fusion && ggml_metal_fusion_get_id(fusion) == GGML_METAL_FUSION_UNARY_MUL;
+    const bool expected = (op == GGML_UNARY_OP_SILU || op == GGML_UNARY_OP_SIGMOID) &&
+                          !reuse && !capture && !strided && type == GGML_TYPE_F32 &&
+                          alias != 2 && !(gate && alias);
+    const bool ok = fused == expected && (!fused || count == 2);
+    std::printf("unary mul: op=%s gate=%d swap=%d reuse=%d capture=%d strided=%d type=%s alias=%d fused=%d expected=%d: %s\n",
+                ggml_unary_op_name(op), gate, swap, reuse, capture, strided, ggml_type_name(type),
+                alias, fused, expected, ok ? "OK" : "FAIL");
+    ggml_backend_buffer_free(buffer);
+    ggml_free(ctx);
+    return ok;
+}
+
+static int run_unary_mul_cases() {
+    int failures = 0;
+    for (auto op : { GGML_UNARY_OP_SILU, GGML_UNARY_OP_SIGMOID }) {
+        for (bool swap : { false, true }) {
+            failures += !check_unary_mul(op, false, swap, false, false, false);
+        }
+        failures += !check_unary_mul(op, true, true, false, false, false);
+        failures += !check_unary_mul(op, false, false, true, false, false);
+        failures += !check_unary_mul(op, false, false, false, true, false);
+        failures += !check_unary_mul(op, false, false, false, false, true);
+        failures += !check_unary_mul(op, false, false, false, false, false, GGML_TYPE_F16);
+        failures += !check_unary_mul(op, false, false, false, false, false, GGML_TYPE_F32, 1);
+        failures += !check_unary_mul(op, false, false, false, false, false, GGML_TYPE_F32, 2);
+        failures += !check_unary_mul(op, true, true, false, false, false, GGML_TYPE_F32, 1);
+    }
+    failures += !check_unary_mul(GGML_UNARY_OP_RELU, false, false, false, false, false);
+    return failures;
+}
+
 int main() {
     const std::vector<device_case> devices = {
         { "native simdgroup matrices",       true,  true },
         { "probed or no simdgroup matrices", false, true },
     };
     const int failures = run_pack_cases(devices) + (check_chained_pack_reader() ? 0 : 1) + run_row_independent_pack_cases() +
-        (check_encoder_skips_weight_residual() ? 0 : 1);
+        (check_encoder_skips_weight_residual() ? 0 : 1) + run_unary_mul_cases();
 
     return failures == 0 ? 0 : 1;
 }
